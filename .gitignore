# -------------------------------
# Blazor / ASP.NET Core / .NET .gitignore
# Generated: tailored for Blazor (server or WebAssembly) projects
# -------------------------------

# Visual Studio and editor folders
.vs/
#.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Bb]in/
[Oo]bj/
out/
artifacts/
publish/

# Rider
*.sln.iml

# NuGet
*.nupkg
packages/
project.lock.json
.nuget/packages/

# .NET Core
*.dll
*.exe
*.pdb
*.mdb
*.runtimeconfig.dev.json
*.runtimeconfig.json
*.deps.json

# EF Core and tooling
*.db
*.db-journal
*.efmodel

# Publish / deployment
*.Publish.xml
*.azurePubxml

# IIS Express
/.vs/*/applicationhost.config

# User secrets (store secrets outside source control)
secrets.json

# Logs
*.log

# Test results
TestResults/
*.trx
*.coverage
coverage.opencover.xml

# Coverage and temporary test files
.coverage
.coverage.*
coverage.xml
htmlcov/

# Tools
/.dotnet/
/.paket/

# Node (Blazor projects sometimes include client-side tooling)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Frontend tooling caches
.parcel-cache/
.cache/

# Static web assets build folders (adjust if you commit these intentionally)
wwwroot/lib/
wwwroot/dist/

# IDE / OS extras
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# JetBrains Rider caches
.idea/
/.idea/*

# Resharper
_ReSharper*/
*.DotSettings.user

# Visual Studio Code workspace storage
#.vscode/*
#!/.vscode/settings.json
#!/.vscode/tasks.json
#!/.vscode/launch.json

# Generated C# files
*.g.cs
*.designer.cs

# Pack and publish artifacts
*.zip
*.tar.gz

# Dotnet local tools cache
.dotnet/tools/

# Local environment files
.env
.env.*

# Keep launchSettings.json if you want to commit local debug settings;
# uncomment the next line to ignore it instead.
# Properties/launchSettings.json

# End of .gitignore

