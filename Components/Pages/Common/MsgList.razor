@using TaskManagerWeb.Components.Pages.Common

@page "/Common/MsgList/{MList}"
@rendermode InteractiveServer
@inject CommonLib CommonLib
@inject IJSRuntime jsRuntime

<style>
    .msglist {
        --msg-height: 580px;
        --msg-width: 250px;
        height: var(--msg-height);
        width: var(--msg-width);
        display: flex;
        flex-direction: column;
        align-items: center;
        box-sizing: border-box;
        background-color: #6e7173;
        border: 1px solid #6e7173;
        overflow-x: clip;
        overflow-y: scroll;
        scrollbar-width: thin;

        ::-webkit-scrollbar {
            width: 1px;
        }

        .msg-outer:first-child {
            margin-top: 3px;
        }

        .msg-outer {
            --outer-height: auto;
            --title-height: 36px;
            height: var(--outer-height);
            width: calc(var(--msg-width) - 23px);
            border: 1px solid black;
            box-sizing: border-box;
            margin-bottom: 3px;

            .msg-top {
                height: var(--title-height);
                width: 189px;
                background-color: #fd9448;
                border-bottom: 1px solid black;
            }

            .msg-text {
                height: calc(var(--outer-height) - var(--title-height));
                width: 100%;
                background-color: #d9d9d9;
            }
        }

        .text-style {
            padding-top: 1px;
            padding-left: 3px;
            display: grid;
            grid-template-rows: 1fr 1fr;
            height: 2.4em;
            line-height: 1.2em;
            overflow: hidden;
            text-overflow: ellipsis;
            width: 189px;
            font-size: 14px;
        }

        .text-style2 {
            padding-left: 3px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            width: 222px;
            display: inline-block;
            font-size: 14px;
        }

        .icon-style {
            height: 37px;
            width: 37px;
            position: relative;
            top: -1px;
            left: 0px;
            border: 1px solid black;
        }

        .icon_cancel_orange {
            height: 35px;
            width: 35px;
            background-size: cover;
            background-repeat: no-repeat;
            background-position: center;
            cursor: pointer;
            background-color: white;
        }
    }
</style>

<div class="msglist">
    @if (MList?.List.Any() ?? false)
    {
        foreach (var item in MList.List)
        {
            string bgStyle = $"background-color: {item.Title.Background};";
            string fontStyle = $"color: {item.Title.Foreground};";

            <div class="msg-outer">
                <div class="msg-top" style="@bgStyle">
                    <div class="segmentRow">
                        <div>
                            <div class="text-style no-select" style="@fontStyle">
                                @item.Title.Text
                            </div>
                        </div>
                        <div>
                            <div class="icon-style" @onclick="() => OnClickMsgCancel(item)">
                                <div class="icon_cancel_orange" />
                            </div>
                        </div>
                    </div>
                </div>
                @{
                    bool isFirst = true;
                    string bgStyle2 = string.Empty;
                    if (item.TextList.Count > 0)
                    {
                        bgStyle2 = $"background-color: {item.TextList[0]?.Background};";
                    }
                }
                <div class="msg-text" style="@bgStyle2">
                    @foreach (var text in item.TextList)
                    {
                        var fontStyle2 = $"color: {text.Foreground};";

                        if (isFirst)
                        {
                            isFirst = false;

                            <div class="text-style2 no-select" style="padding-top: 3px; @fontStyle2">
                                @text.Text
                            </div>
                        }
                        else
                        {
                            <div class="text-style2 no-select" style="@fontStyle2">
                                @text.Text
                            </div>
                        }
                    }
                </div>
            </div>
        }
    }
</div>