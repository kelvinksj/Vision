@using TaskManagerWeb.Components.Pages.Common

@page "/Common/PopLine/{PopLineData}"
@rendermode InteractiveServer
@inject CommonLib CommonLib
@inject IJSRuntime jsRuntime

<style>
    .popline-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1000;

        .pop-content {
            position: relative;
            height: 400px;
            width: 500px;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: white;
            border: 2px solid black;
        }

        .label-set {
            font-size: 20px;
            font-weight: bold;
            text-align: center;
        }

        .btn-wrapper {
            width: 100%;
            display: flex;
            justify-content: center;

            .btn-set {
                background-color: rgba(243, 109, 51, 1);
                border-color: rgba(243, 109, 51, 1);
                color: white;
                border-radius: 30px;
                font-size: 20px;
                font-weight: bold;
                width: 130px;
                height: 50px;
            }
        }

        .icon-wrapper {
            height: 50px;
            width: 50px;
            background-size: cover;
            background-repeat: no-repeat;
            background-position: center;
        }

        .text-center {
            height: 100%;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
        }

        .box-outer {
            --outer-height: 150px;
            --title-header: 0.3;
            --title-height: 0.4;
            height: var(--outer-height);
            width: 150px;
            border: 1px solid black;
            box-sizing: border-box;

            .box-header {
                height: calc((var(--outer-height) * var(--title-header)));
                width: 100%;
                background-color: #d3d3d3;
            }

            .box-top {
                height: calc((var(--outer-height) * var(--title-height)) - 1px);
                width: 100%;
                background-color: #d3d3d3;
            }

            .box-text {
                height: calc((var(--outer-height) * (1 - var(--title-header) - var(--title-height))) - 1px);
                width: 100%;
                background-color: white;
            }
        }

        .box-outer2 {
            --outer-height: 150px;
            --title-header: 0.0;
            --title-height: 0.7;
            height: var(--outer-height);
            width: 150px;
            border: 1px solid black;
            box-sizing: border-box;

            .box-header {
                height: calc((var(--outer-height) * var(--title-header)));
                width: 100%;
                background-color: #d3d3d3;
            }

            .box-top {
                height: calc((var(--outer-height) * var(--title-height)) - 1px);
                width: 100%;
                background-color: #d3d3d3;
            }

            .box-text {
                height: calc((var(--outer-height) * (1 - var(--title-header) - var(--title-height))) - 1px);
                width: 100%;
                background-color: white;
            }
        }
    }
</style>

@if (PopLineData.ActivatePopup)
{
    <div class="popline-overlay" style="@(true ? "display: flex;" : "display: none;")">
        <div class="pop-content">
            @{
                if (PopLineData.IconClick != null)
                {
                    <div style="position: absolute; top: 5px; right: 5px;">
                        <div class="icon_cancel_orange icon-wrapper" @onclick="() => PopLineData.IconClick()" />
                    </div>
                }

                if (PopLineData.Text_1 != null
                && PopLineData.Text_1 != string.Empty)
                {
                    <label class="label-set">@PopLineData.Text_1</label>
                }

                if (PopLineData.Text_2 != null
                && PopLineData.Text_2 != string.Empty)
                {
                    <label class="label-set">@PopLineData.Text_2</label>
                }

                if (PopLineData.BoxType != null
                && boxStyle != string.Empty
                && textStyle != string.Empty)
                {
                    if (boxType == "SKU")
                    {
                        <div class="box-outer" style="margin-top: 10px; margin-bottom: 10px;">
                            <div class="box-header" style="background-color: white; color: black;">
                                <div class="text-center no-select" style="font-size: large; @textStyle">
                                    @PopLineData.BoxText_1
                                </div>
                            </div>
                            <div class="box-top" style="font-size: xx-large; @boxStyle">
                                <div class="text-center no-select" style="@textStyle">
                                    @PopLineData.BoxText_2
                                </div>
                            </div>
                            <div class="box-text">
                                <div class="text-center no-select" style="font-size: x-large;">
                                    @PopLineData.BoxText_3
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="box-outer2" style="margin-top: 10px; margin-bottom: 10px;">
                            <div class="box-top" style="@boxStyle">
                                <div class="text-center no-select" style="font-size: xx-large; @textStyle">
                                    @PopLineData.BoxText_2
                                </div>
                            </div>
                            <div class="box-text">
                                <div class="text-center no-select" style="font-size: x-large;">
                                    @PopLineData.BoxText_3
                                </div>
                            </div>
                        </div>
                    }
                }

                if ((PopLineData.BtnText_1 != null
                && PopLineData.BtnText_1 != string.Empty
                && PopLineData.BtnClick_1 != null)
                || (PopLineData.BtnText_2 != null
                && PopLineData.BtnText_2 != string.Empty
                && PopLineData.BtnClick_2 != null))
                {
                    <div class="btn-wrapper" style="margin-bottom: 10px;">
                        @{
                            if (PopLineData.BtnText_1 != null
                            && PopLineData.BtnText_1 != string.Empty
                            && PopLineData.BtnClick_1 != null)
                            {
                                if (PopLineData.BtnText_2 != null
                                && PopLineData.BtnText_2 != string.Empty
                                && PopLineData.BtnClick_2 != null)
                                {
                                    <button type="button" class="PopMsgBtn btn btn-set gapRight" @onclick="() => PopLineData.BtnClick_1()">
                                        @PopLineData.BtnText_1
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="PopMsgBtn btn btn-set" @onclick="() => PopLineData.BtnClick_1()">
                                        @PopLineData.BtnText_1
                                    </button>
                                }
                            }

                            if (PopLineData.BtnText_2 != null
                            && PopLineData.BtnText_2 != string.Empty
                            && PopLineData.BtnClick_2 != null)
                            {
                                <button type="button" class="PopMsgBtn btn btn-set" @onclick="() => PopLineData.BtnClick_2()">
                                    @PopLineData.BtnText_2
                                </button>
                            }
                        }
                    </div>
                }

                if ((PopLineData.BtnText_3 != null
                && PopLineData.BtnText_3 != string.Empty
                && PopLineData.BtnClick_3 != null)
                || (PopLineData.BtnText_4 != null
                && PopLineData.BtnText_4 != string.Empty
                && PopLineData.BtnClick_4 != null))
                {
                    <div class="btn-wrapper">
                        @{
                            if (PopLineData.BtnText_3 != null
                            && PopLineData.BtnText_3 != string.Empty
                            && PopLineData.BtnClick_3 != null)
                            {
                                if (PopLineData.BtnText_4 != null
                                && PopLineData.BtnText_4 != string.Empty
                                && PopLineData.BtnClick_4 != null)
                                {
                                    <button type="button" class="PopMsgBtn btn btn-set gapRight" @onclick="() => PopLineData.BtnClick_3()">
                                        @PopLineData.BtnText_3
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="PopMsgBtn btn btn-set" @onclick="() => PopLineData.BtnClick_3()">
                                        @PopLineData.BtnText_3
                                    </button>
                                }
                            }

                            if (PopLineData.BtnText_4 != null
                            && PopLineData.BtnText_4 != string.Empty
                            && PopLineData.BtnClick_4 != null)
                            {
                                <button type="button" class="PopMsgBtn btn btn-set" @onclick="() => PopLineData.BtnClick_4()">
                                    @PopLineData.BtnText_4
                                </button>
                            }
                        }
                    </div>
                }
            }
        </div>
    </div>
}