@using TaskManagerWeb.Components.Pages.Common

@page "/Common/PopContainer/{PopContainerData}"
@rendermode InteractiveServer
@inject CommonLib CommonLib
@inject IJSRuntime jsRuntime

<style>
    .popcontainer-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1000;

        .pop-content {
            position: relative;
            height: 400px;
            width: 500px;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: white;
            border: 2px solid black;
        }

        .label-set {
            font-size: 20px;
            font-weight: bold;
            text-align: center;
        }

        .btn-wrapper {
            width: 100%;
            display: flex;
            justify-content: center;

            .btn-set {
                background-color: rgba(243, 109, 51, 1);
                border-color: rgba(243, 109, 51, 1);
                color: white;
                border-radius: 30px;
                font-size: 20px;
                font-weight: bold;
                width: 130px;
                height: 50px;
            }
        }

        .icon-wrapper {
            height: 50px;
            width: 50px;
            background-size: cover;
            background-repeat: no-repeat;
            background-position: center;
        }

        .text-center {
            height: 100%;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
        }

        .box-outer {
            --outer-height: 150px;
            --outer-width: 150px;
            --title-header: 0.2;
            --title-height: 0.6;
            height: var(--outer-height);
            width: var(--outer-width);
            border: 1px solid black;
            box-sizing: border-box;

            .box-header {
                height: calc((var(--outer-height) * var(--title-header)));
                width: 100%;
                background-color: #d3d3d3;
            }

            .box-top {
                height: calc((var(--outer-height) * var(--title-height)) - 1px);
                width: 100%;
                background-color: #d3d3d3;
            }

            .box-text {
                height: calc((var(--outer-height) * (1 - var(--title-header) - var(--title-height))) - 1px);
                width: 100%;
                background-color: white;
            }
        }

        .icon_box {
            height: 100%;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .load_box {
            height: calc(100% - 30%);
            width: calc(100% - 20%);
        }

        .icon_x_red {
            width: calc(100% - 30%);
            height: calc(100% - 30%);
            background-size: cover;
            background-repeat: no-repeat;
            background-position: center;
        }
    }
</style>

@if (PopContainerData.ActivatePopup)
{
    <div class="popcontainer-overlay" style="@(true ? "display: flex;" : "display: none;")">
        <div class="pop-content">
            @{
                if (PopContainerData.IconClick != null)
                {
                    <div style="position: absolute; top: 5px; right: 5px;">
                        <div class="icon_cancel_orange icon-wrapper" @onclick="() => PopContainerData.IconClick()" />
                    </div>
                }

                if (PopContainerData.Text_1 != null
                && PopContainerData.Text_1 != string.Empty)
                {
                    <label class="label-set">@PopContainerData.Text_1</label>
                }

                if (PopContainerData.Text_2 != null
                && PopContainerData.Text_2 != string.Empty)
                {
                    <label class="label-set">@PopContainerData.Text_2</label>
                }

                <div class="box-outer" style="margin-top: 10px; margin-bottom: 10px;">
                    <div class="box-header" style="background-color: white; color: black;">
                        <div class="text-center no-select">
                            @PopContainerData.Point
                        </div>
                    </div>
                    <div class="box-top">
                        @if (PopContainerData.ContainerType == "CheckOut")
                        {
                            <div class="icon_box" style="background-color: #bad0fb;">
                                <div class="icon_x_red" style="background-color: #bad0fb;" />
                            </div>
                        }
                        else if (PopContainerData.ContainerType == "LoadOut")
                        {
                            <div class="icon_box" style="background-color: #bad0fb;">
                                <div class="load_box" style="background-color: #fbe9d0;" />
                            </div>
                        }
                        else if (PopContainerData.ContainerType == "Empty")
                        {
                            <div class="icon_box" style="background-color: #d9d9d9;" />
                        }
                        else if (PopContainerData.ContainerType == "Table")
                        {
                            <div class="icon_box" style="background-color: #fd9448;" />
                        }
                        else if (PopContainerData.ContainerType == "Loaded"
                        || PopContainerData.ContainerType == "Full")
                        {
                            <div class="icon_box" style="background-color: #fd9448;">
                                <div class="load_box" style="background-color: #fbe9d0;" />
                            </div>
                        }
                        else
                        {
                            <div class="icon_box" style="background-color: red;" />
                        }
                    </div>
                    <div class="box-text" style="background-color: white; color: black;">
                        <div class="text-center no-select">
                            @PopContainerData.ContainerType
                        </div>
                    </div>
                </div>

                if ((PopContainerData.BtnText_1 != null
                && PopContainerData.BtnText_1 != string.Empty
                && PopContainerData.BtnClick_1 != null)
                || (PopContainerData.BtnText_2 != null
                && PopContainerData.BtnText_2 != string.Empty
                && PopContainerData.BtnClick_2 != null))
                {
                    <div class="btn-wrapper" style="margin-bottom: 10px;">
                        @{
                            if (PopContainerData.BtnText_1 != null
                            && PopContainerData.BtnText_1 != string.Empty
                            && PopContainerData.BtnClick_1 != null)
                            {
                                if (PopContainerData.BtnText_2 != null
                                && PopContainerData.BtnText_2 != string.Empty
                                && PopContainerData.BtnClick_2 != null)
                                {
                                    <button type="button" class="PopMsgBtn btn btn-set gapRight" @onclick="() => PopContainerData.BtnClick_1()">
                                        @PopContainerData.BtnText_1
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="PopMsgBtn btn btn-set" @onclick="() => PopContainerData.BtnClick_1()">
                                        @PopContainerData.BtnText_1
                                    </button>
                                }
                            }

                            if (PopContainerData.BtnText_2 != null
                            && PopContainerData.BtnText_2 != string.Empty
                            && PopContainerData.BtnClick_2 != null)
                            {
                                <button type="button" class="PopMsgBtn btn btn-set" @onclick="() => PopContainerData.BtnClick_2()">
                                    @PopContainerData.BtnText_2
                                </button>
                            }
                        }
                    </div>
                }

                if ((PopContainerData.BtnText_3 != null
                && PopContainerData.BtnText_3 != string.Empty
                && PopContainerData.BtnClick_3 != null)
                || (PopContainerData.BtnText_4 != null
                && PopContainerData.BtnText_4 != string.Empty
                && PopContainerData.BtnClick_4 != null))
                {
                    <div class="btn-wrapper">
                        @{
                            if (PopContainerData.BtnText_3 != null
                            && PopContainerData.BtnText_3 != string.Empty
                            && PopContainerData.BtnClick_3 != null)
                            {
                                if (PopContainerData.BtnText_4 != null
                                && PopContainerData.BtnText_4 != string.Empty
                                && PopContainerData.BtnClick_4 != null)
                                {
                                    <button type="button" class="PopMsgBtn btn btn-set gapRight" @onclick="() => PopContainerData.BtnClick_3()">
                                        @PopContainerData.BtnText_3
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="PopMsgBtn btn btn-set" @onclick="() => PopContainerData.BtnClick_3()">
                                        @PopContainerData.BtnText_3
                                    </button>
                                }
                            }

                            if (PopContainerData.BtnText_4 != null
                            && PopContainerData.BtnText_4 != string.Empty
                            && PopContainerData.BtnClick_4 != null)
                            {
                                <button type="button" class="PopMsgBtn btn btn-set" @onclick="() => PopContainerData.BtnClick_4()">
                                    @PopContainerData.BtnText_4
                                </button>
                            }
                        }
                    </div>
                }
            }
        </div>
    </div>
}