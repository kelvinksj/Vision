@using TaskManagerWeb.Components.Pages.Common

@page "/Account/Users"
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject CommonLib CommonLib
@inject IJSRuntime JS
@inject MattelService MattelService
@inject NavigationManager NavigationManager
@inject PaginationService<UserAccount> PaginationService
@inject ScreenWakeLockService ScreenWakeLockService
@inject SortingModel<UserAccount> SortingModel
@inject UserAccountService UserAccountService
@inject WorkerService WorkerService

<style>
    .input {
        margin-right: 20px;
        background-color: rgba(217, 217, 217, 1);
        border-color: black;
        border-radius: 0px;
        width: 230px;
    }

    .label {
        font-size: 20px;
        font-weight: bold;
        color: rgba(110, 113, 115, 1);
        margin-top: 10px;
    }

    .modal-overlay {
        display: flex;
        justify-content: center;
        align-items: center;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1000;
    }

    .modal-content {
        background: white;
        width: 35%;
        height: auto;
        min-width: fit-content;
        position: relative;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .modal-header {
        width: 100%;
        background: rgba(110, 113, 115, 1);
        color: white;
        padding: 10px;
        font-size: 28px;
        font-weight: bold;
        height: auto;
        position: relative;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .modal-active .top-row {
        pointer-events: none;
        opacity: 0.5;
    }

    .page-nav {
        cursor: pointer;
        margin: 5px;
        text-decoration: none;
        font-size: 16px;
        border: none;
    }

    .icon_filter {
        display: inline-block;
        width: 20px;
        height: 20px;
        position: absolute;
        right: 0;
        bottom: 7px;
        margin-right: 5px;
        background-size: cover;
        cursor: pointer;
    }

    .label-remove {
        font-size: 20px;
        font-weight: bold;
        text-align: center;
    }

    .icon_delete {
        display: inline-block;
        width: 150px;
        height: 150px;
        background-size: cover;
    }

    .icon_cancel {
        display: inline-block;
        width: 40px;
        height: 40px;
        position: absolute;
        top: 0;
        margin-top: 10px;
        right: 0;
        margin-right: 5px;
        background-size: contain;
        cursor: pointer;
    }

    .table-set {
        height: 400px;
    }

    .btn-wrapper {
        width: 100%;
        display: flex;
        justify-content: center;

        .common-btn {
            width: 130px;
            height: 50px;
        }
    }

    .disable-btn {
    @backgroundColor
    @borderColor
    }

    .disable-delete {
    @bgColorDelete
    @borderColorDelete
    }

    .setSVG {
        position: absolute;
        right: 5px;
        top: 13px;
        width: 24px;
        height: 24px;
    }

    .segmentColumn2 {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    @* width: 750px; *@
    }

    .Paging {
        height: 60px;
    }
</style>

<PageTitle>@CommonParameters.AppName</PageTitle>

<AuthorizeView Roles="Administrator,Engineer,Supervisor,Operator">
    <Authorized>
        <div class="outer">
            <div class="contain-size">
                <div class="box1">
                    <h1 id="MyHeader" class="header no-select">
                        User Maintenance
                    </h1>
                </div>
                <div class="box-wrapper">
                    <div class="box2">
                        <div class="gapBottom">
                            <AuthorizeView Roles="Administrator">
                                <Authorized Context="Auth2">
                                    <div class="segmentColumn">
                                        <label class="label no-select">Please enter a filter :</label>
                                        <div class="segmentRow">
                                            <input class="form-control input" autocomplete="off" maxlength="15"
                                                @oninput="@(e => FilterUsers(e!.Value!.ToString()!))" />
                                            <button type="button" @onclick="ShowAddUserModal"
                                                disabled="@disableAddButton" class="btn btn-sm common-btn gapRight">
                                                Add
                                            </button>
                                            <button type="button" @onclick="EditSelectedUser"
                                                disabled="@disableEditButton"
                                                class="btn btn-sm common-btn disable-btn gapRight">
                                                Edit
                                            </button>
                                            <button type="button" @onclick="DeleteSelectedUser"
                                                disabled="@disableDeleteButton"
                                                class="btn btn-sm common-btn disable-delete">
                                                Delete
                                            </button>
                                        </div>
                                    </div>
                                </Authorized>
                            </AuthorizeView>
                            <AuthorizeView Roles="Engineer,Supervisor,Operator">
                                <Authorized Context="Auth3">
                                    <button type="button" @onclick="EditSelectedUser" disabled="@disableEditButton"
                                        class="btn btn-sm common-btn">Edit</button>
                                </Authorized>
                            </AuthorizeView>
                        </div>
                        <div class="segmentColumn2 gapRight">
                            <div class="table-set">
                                <table class="table scrolldown">
                                    <colgroup>
                                        <col style="width: 150px;">
                                        <col style="width: 150px;">
                                        <col style="width: 150px;">
                                        <col style="width: 150px;">
                                        <col style="width: 180px;">
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th>
                                                <div class="segmentRow">
                                                    <div class="no-select gapRight" style="margin-left: 8px;">
                                                        Username
                                                    </div>
                                                    <div class="@(SortingModel.SortIcons["UserName"]) setSVG"
                                                        @onclick="@(async () => await SortItems("UserName"))" />
                                                </div>
                                            </th>
                                            <th>
                                                <div class="segmentRow">
                                                    <div class="no-select gapRight" style="margin-left: 8px;">
                                                        First Name
                                                    </div>
                                                    <div class="@(SortingModel.SortIcons["FirstName"]) setSVG"
                                                        @onclick="@(async () => await SortItems("FirstName"))" />
                                                </div>
                                            </th>
                                            <th>
                                                <div class="segmentRow">
                                                    <div class="no-select gapRight" style="margin-left: 8px;">
                                                        Last Name
                                                    </div>
                                                    <div class="@(SortingModel.SortIcons["LastName"]) setSVG"
                                                        @onclick="@(async () => await SortItems("LastName"))" />
                                                </div>
                                            </th>
                                            <th>
                                                <div class="segmentRow">
                                                    <div class="no-select gapRight" style="margin-left: 8px;">
                                                        Role
                                                    </div>
                                                    <div class="@(SortingModel.SortIcons["UserRole"]) setSVG"
                                                        @onclick="@(async () => await SortItems("UserRole"))" />
                                                </div>
                                            </th>
                                            <th>
                                                <div class="segmentRow">
                                                    <div class="no-select gapRight" style="margin-left: 8px;">
                                                        Page
                                                    </div>
                                                    <div class="@(SortingModel.SortIcons["PageDescription"]) setSVG"
                                                        @onclick="@(async () => await SortItems("PageDescription"))" />
                                                </div>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (PaginationService.GetItems() != null && PaginationService.GetItems().Any())
                                        {
                                            @foreach (var user in PaginationService.GetItems())
                                            {
                                                <tr class="@GetRowClass(user)" @onclick="() => SelectUser(user)">
                                                    <td>
                                                        <div class="no-select">@user.UserName</div>
                                                    </td>
                                                    <td>
                                                        <div class="no-select">@user.FirstName</div>
                                                    </td>
                                                    <td>
                                                        <div class="no-select">@user.LastName</div>
                                                    </td>
                                                    <td>
                                                        <div class="no-select">@user.UserRole</div>
                                                    </td>
                                                    <td>
                                                        <div class="no-select">@user.PageDescription</div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="5" class="text-center no-select">
                                                    <div>No data</div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    @if (loading || users == null || users.Count <= 0)
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center no-select">
                                                <span class="spinner-border spinner-border-lg align-center"></span>
                                                <span> Loading data in progress ...........</span>
                                            </td>
                                        </tr>
                                    }
                                </table>
                            </div>
                            <div class="Paging">
                                <Pagination T="UserAccount" PaginationService="PaginationService"
                                    OnPageChanged="OnPageChanged" />
                            </div>
                        </div>
                        @if (showModal)
                        {
                            <div class="modal-overlay" style="@(showModal ? "display: flex;" : "display: none;")">
                                <div class="modal-content">
                                    @if (modalContent == "add" || modalContent == "edit")
                                    {
                                        <div class="modal-header">
                                            @if (modalContent == "add")
                                            {
                                                <div class="no-select">Create Account</div>
                                            }
                                            else if (modalContent == "edit")
                                            {
                                                <div class="no-select">Edit Account</div>
                                            }
                                        </div>
                                    }
                                    @if (modalContent == "add")
                                    {
                                        <Add userID="1" ShowModalChanged="ShowAddModalChanged" OnUserAdded="OnUserAdded" />
                                    }
                                    else if (modalContent == "edit")
                                    {
                                        <Edit userID="selectedUserId" ShowModalChanged="ShowEditModalChanged"
                                            OnUserEdited="OnUserEdited" />
                                    }
                                </div>
                            </div>
                        }
                        @if (showSuccessModal)
                        {
                            <div class="modal-overlay">
                                <div class="modal-content">
                                    @if (successContent == "AddSuccess")
                                    {
                                        <AddSuccess ShowModalChanged="ShowSuccessModalChanged" />
                                    }
                                    else if (successContent == "EditSuccess")
                                    {
                                        <EditSuccess ShowModalChanged="ShowSuccessModalChanged" />
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <PopMsg PopMsgData="@popMsgData" />
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <span class="spinner-border spinner-border-lg align-center"></span>
        <span> Checking authorization in progress ...........</span>
    </NotAuthorized>
</AuthorizeView>