@page "/Account/Logout"
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject CommonLib CommonLib
@inject NavigationManager NavigationManager

@code
{
    private string taskName = "Logout";
    private MessageLevel settingLevel => DebugParameters.MsgLvl_AccLogout;
    string currentUrl = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        CommonLib.DisplayConsole(
            taskName,
            $"OnInitializedAsync triggered",
            settingLevel,
            MessageLevel.Information
        );

        try
        {
            currentUrl = NavigationManager.Uri;
            CommonLib.DisplayConsole(
                taskName,
                $"OnInitializedAsync: urlPage={currentUrl}, taskName={taskName}",
                settingLevel,
                MessageLevel.Trace
            );

            var customAuthenticationStateProvider = (CustomAuthenticationStateProvider)AuthenticationStateProvider;
            await customAuthenticationStateProvider.UpdateAuthenticationState(null!);

            CommonLib.DisplayConsole(
                taskName,
                $"Logout done",
                settingLevel,
                MessageLevel.Information
            );

            await base.OnInitializedAsync();
        }
        catch (Exception ex)
        {
            CommonLib.DisplayConsole(
                taskName,
                ex,
                settingLevel,
                MessageLevel.Error
            );
        }

        NavigationManager.NavigateTo("/", true, true);
    }
}