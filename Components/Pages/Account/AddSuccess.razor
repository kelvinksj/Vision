@page "/Account/AddSuccess"

<style>
    .modal-overlay {
        display: flex;
        justify-content: center;
        align-items: center;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1000;
    }

    .modal-content {
        background: white;
        border: 2px solid black;
        border-radius: 0px;
        width: 25%;
        height: auto;
        min-width: fit-content;
        padding: 10px;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .button {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top: 10px;
    }

    .button-start {
        background-color: rgba(243, 109, 51, 1);
        border-color: rgba(243, 109, 51, 1);
        color: white;
        border-radius: 30px;
        font-size: 20px;
        font-weight: bold;
        width: 100px;
        height: 40px;
    }

    .icon_face_5 {
        display: inline-block;
        width: 150px;
        height: 150px;
        background-size: cover;
    }

    .label-style {
        font-size: 20px;
        font-weight: bold;
    }
</style>

<PageTitle>@CommonParameters.AppName</PageTitle>

<label class="label-style">User created <br> successfully !!</label>
<div class="icon_face_5"></div>
<div>
    <button type="button" @onclick="CloseModal" class="button button-start">OK</button>
</div>

@code {
    [Parameter] public bool showModal { get; set; }
    [Parameter] public EventCallback<bool> ShowModalChanged { get; set; }
    private async Task CloseModal()
    {
        await ShowModalChanged.InvokeAsync(false); // Close the modal
    }
}