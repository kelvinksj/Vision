@page "/Menu/MenuKit"
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject CommonLib CommonLib
@inject IJSRuntime jsRuntime
@inject NavigationManager NavigationManager
@inject ScreenWakeLockService ScreenWakeLockService
@inject UserAccountService UserAccountService
@inject WorkerService WorkerService

<style>
    .content {
        display: flex;
        flex-wrap: wrap;
    @* gap: 10px; *@
    }

    .box {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 300px;
        height: 250px;
        background-color: white;
        color: white;
        position: relative;
        cursor: pointer;
        transition: background-color 0.3s ease;
        border: 2px solid black;
    }

    .box:hover {
        background-color: rgba(217, 217, 217, 1);
    }

    .box label {
        position: absolute;
        top: 0;
        margin: 0;
        background-color: rgba(110, 113, 115, 1);
        width: 100%;
        text-align: center;
        color: white;
        box-sizing: content-box;
        border-bottom: 2px solid black;
        font-size: 28px;
    }

    .setSVG {
        margin-top: 50px;
    }
</style>

<PageTitle>@CommonParameters.AppName</PageTitle>

<AuthorizeView Roles="Administrator,Engineer,Supervisor,Operator">
    <Authorized>
        <div class="outer">
            <div class="contain-size">
                <div class="inner">
                    <div class="segmentColumn">
                        <div class="segmentRow" style="margin-bottom: 45px;">
                            <div class="box" style="margin-right: 45px;" @onclick="Navigate1">
                                <label class="no-select">Manual</label>
                                <div class="icon_keyboard_onScreen_grey setSVG" />
                            </div>
                            <div class="box" style="margin-right: 45px;" @onclick="Navigate2">
                                <label class="no-select">Scan One</label>
                                <div class="icon_document_scan_grey setSVG" />
                            </div>
                            <div class="box" @onclick="Navigate3">
                                <label class="no-select">Scan All</label>
                                <div class="icon_document_scan_grey setSVG" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <span class="spinner-border spinner-border-lg align-center"></span>
        <span> Checking authorization in progress ...........</span>
    </NotAuthorized>
</AuthorizeView>