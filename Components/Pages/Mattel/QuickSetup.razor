@using TaskManagerWeb.Components.Pages.Common

@page "/Mattel/QuickSetup"
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject CommonLib CommonLib
@inject HttpClient Http
@inject IJSRuntime jsRuntime
@inject MattelService MattelService
@inject NavigationManager NavigationManager
@inject IServiceProvider ServiceProvider

<style>
    .button-add,
    .button-save {
        background-color: #f36d33;
        border-color: #f36d33;
        border-radius: 30px;
        color: white;
        width: 120px;
        height: 40px;
        font-size: 20px;
        margin-right: 10px;
    }

    .button-clear {
        background-color: #fd9448;
        border-color: #fd9448;
        border-radius: 30px;
        color: white;
        width: 120px;
        height: 40px;
        font-size: 20px;
        margin-right: 10px;
    }

    .button-add:hover,
    .button-save:hover {
        background-color: white;
        color: black;
    }

    .custom-select-wrapper {
        position: relative;
        display: inline-block;

        .custom-select {
            width: 180px;
            outline: none !important;
        }

        .custom-select-arrow {
            position: absolute;
            left: 150px;
            top: 6px;
            pointer-events: none;
        }
    }

    .text-center {
        height: 100%;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }

    .box-outer {
        --outer-height: 60px;
        --outer-width: 60px;
        --title-height: 0.6;
        height: var(--outer-height);
        width: var(--outer-width);
        border: 1px solid black;
        box-sizing: border-box;
        cursor: pointer;

        .box-top {
            height: calc((var(--outer-height) * var(--title-height)) - 1px);
            width: 100%;
            background-color: #d3d3d3;
        }

        .box-text {
            height: calc((var(--outer-height) * (1 - var(--title-height))) - 1px);
            width: 100%;
            background-color: white;
        }
    }

    .box-list {
        height: 100%;
        width: 150px;
        border: 1px solid black;
        box-sizing: border-box;
        overflow-x: hidden;
        overflow-y: scroll;
        scrollbar-width: thin;
    }

    .list-wrapper {
        width: 100%;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid red;
        cursor: pointer;
    }

    .outer {
        .box-wrapper {
            justify-content: left;
        }
    }

    .dropdown-list {
        position: absolute;
        background-color: white;
        border: 1px solid #ccc;
        width: 100%;
        max-height: 150px;
        overflow-y: auto;
        z-index: 1000;
        border-radius: 8px;
        line-height: 0.8em;
    }

    .dropdown-item {
        padding: 8px;
        cursor: pointer;
    }

    .dropdown-item:hover {
        background-color: #1967d2;
        color: #ffffff;
    }

    .icon_visibility,
    .icon_visibility_off {
        display: inline-block;
        width: 50px;
        height: 50px;
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
        cursor: pointer;
    }

    .icon_information {
        width: 30px;
        height: 30px;
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
    }
</style>

<script>
    window.setDragData = function (data) {
        document.addEventListener('dragstart', function (event) {
            event.dataTransfer.setData("application/json", JSON.stringify(data));
        });
    };
</script>

<PageTitle>@CommonParameters.AppName</PageTitle>

<AuthorizeView Roles="Administrator,Engineer,Supervisor">
    <Authorized>
        <div class="outer">
            <div class="contain-size">
                <div class="box1">
                    <div class="segmentRow gapBottom">
                        <h1 id="MyHeader" class="header no-select gapRight">
                            Quick Setup
                        </h1>
                        <EditForm Model="@orderKit" OnValidSubmit="() => OnValidSubmit2(orderKit)" autocomplete="off"
                            Context="editContextOrderKit">
                            <DataAnnotationsValidator />
                            <div class="segmentRow">
                                <div class="segmentColumn gapRight">
                                    <label class="no-select">Kit</label>
                                    <div class="custom-select-wrapper">
                                        @* <input type="text" class="form-control custom-select" maxlength="15" style="@selectFontColor"
                                            @bind-value="orderKit.KitNumber"
                                            @bind-value:after="() => HandleOnChange2(orderKit.KitNumber)"
                                            @oninput="(e) => FilterKit(e!.Value!.ToString()!)" @onclick="() => ToggleKitDropdown()" /> *@
                                        <InputText class="form-control custom-select" maxlength="15" style="@selectFontColor"
                                            @bind-Value="orderKit.KitNumber"
                                            @oninput="(e) => FilterKit(e!.Value!.ToString()!)" @onclick="() => ToggleKitDropdown()" />
                                        <div class="dropdown-list" style="@(showKitDropdown ? "display:block;" : "display:none;")">
                                            @foreach (var item in filteredKitNumbers)
                                            {
                                                <div class="dropdown-item" @onclick="() => SelectKitNumber(item.KitNumber)">
                                                    @item.KitNumber
                                                </div>
                                            }
                                        </div>
                                        <svg class="custom-select-arrow" width="24" height="24" viewBox="0 0 24 24"
                                            fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M7 10l5 5 5-5" stroke="#000" stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                    </div>
                                </div>
                            </div>
                        </EditForm>
                        <EditForm Model="@layoutData" OnValidSubmit="() => OnValidSubmit(layoutData)" autocomplete="off"
                            Context="editContextLayout">
                            <DataAnnotationsValidator />
                            <div class="segmentRow">
                                <div class="segmentColumn gapRight">
                                    <label class="no-select">Layout Type:</label>
                                    <div class="custom-select-wrapper">
                                        @* <input type="text" class="form-control custom-select" maxlength="15" style="@selectFontColor"
                                            @bind-value="layoutData.LayoutTypeName"
                                            @bind-value:after="() => HandleOnChange(layoutData.LayoutTypeName)" 
                                            @onclick="() => ToggleLayoutDropdown()" /> *@
                                        <InputText class="form-control custom-select" maxlength="15" style="@selectFontColor"
                                            @bind-Value="layoutData.LayoutTypeName" @onclick="() => ToggleLayoutDropdown()" />
                                        <div class="dropdown-list" style="@(showLayoutDropdown ? "display:block;" : "display:none;")">
                                            @foreach (var item in layoutTypeList.LayoutTypeData)
                                            {
                                                if (item.LayoutType == "Production")
                                                {
                                                    <div class="dropdown-item" @onclick="() => SelectLayoutType(item.LayoutTypeName)">
                                                        @item.LayoutTypeName
                                                    </div>
                                                }
                                            }
                                        </div>
                                        <svg class="custom-select-arrow" width="24" height="24" viewBox="0 0 24 24"
                                            fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M7 10l5 5 5-5" stroke="#000" stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                    </div>
                                </div>
                                @if (isEye)
                                {
                                    newClass = "icon_visibility_off";
                                }
                                else
                                {
                                    newClass = "icon_visibility";
                                }
                                <button type="button" class="btn btn-sm button-add" style="margin-top: 22px;"
                                    @onclick="() => OnClickAdd()" disabled="@(!IsCreateButtonEnabled)">Save</button>
                                <button type="button" class="btn btn-sm button-clear" style="margin-top: 22px;"
                                    @onclick="() => OnClickClear()">Clear All</button>
                                <div class="@newClass" style="margin-top: 18px;" @onclick="() => HandleOnClickEye()" />
                            </div>
                        </EditForm>
                    </div>
                </div>
                @if (isEye)
                {
                    <div class="box-wrapper">
                        <div class="box2">
                            <div class="segmentRow">
                                <div class="segmentColumn" style="width: 700px; height: auto;">
                                    @if (layoutData != null)
                                    {
                                        <RenderFragmentComponent Content="dynamicComponent!" />
                                    }
                                </div>
                                <div class="segmentColumn" style="top: -10px;">
                                    <label class="no-select">Part Number:</label>
                                    <div class="box-list">
                                        <div class="segmentColumn" style="margin: 5px;">
                                            @if (partNumbers != null)
                                            {
                                                foreach (var item in partNumbers.SheetData)
                                                {
                                                    if (item != partNumbers.SheetData.Last())
                                                    {
                                                        <div class="list-wrapper" style="margin-bottom: 5px;" draggable="true"
                                                            @onmousedown="() => HandleOnMouseDown()"
                                                            @ondragstart="async () => HandleDragStart2(item)">
                                                            <div class="no-select">
                                                                @item.PartNumber
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="list-wrapper" draggable="true"
                                                            @onmousedown="() => HandleOnMouseDown()"
                                                            @ondragstart="async () => HandleDragStart2(item)">
                                                            <div class="no-select">
                                                                @item.PartNumber
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="box-wrapper">
                        <div class="box2">
                            <div class="segmentRow">
                                <div class="segmentColumn" style="width: 720px; height: auto;">
                                    @if (layoutData != null)
                                    {
                                        <RenderFragmentComponent Content="dynamicComponent!" />
                                    }
                                </div>
                                <div class="segmentColumn">
                                    <div class="segmentRow gapBottom">
                                        <div class="icon_information gapRight" />
                                        <div style="font-size: 16px; color: red;">
                                            Please Drag & Drop to <br> create your layout
                                        </div>
                                    </div>
                                    @if (containerTypeList != null && containerTypeList.List.Count > 0)
                                    {
                                        foreach (var item in containerTypeList.List)
                                        {
                                            if (item.ContainerType != "NA" && item.ContainerType != "TBL")
                                            {
                                                boxStyle = $"background-color: {item.BoxColor};";
                                                textStyle = $"color: {item.FontColor};";
                                                <div class="gapBottom">
                                                    <div class="box-outer" draggable="true" @onmousedown="() => HandleOnMouseDown()"
                                                        @ondragstart="@(async () => HandleDragStart(item))">
                                                        <div class="box-top" style="z-index: -100; @boxStyle">
                                                            <div class="text-center no-select" style="@textStyle">
                                                                @item.ContainerType
                                                            </div>
                                                        </div>
                                                        <div class="box-text" style="z-index: -100;">
                                                            <div class="text-center no-select">
                                                                XXXX
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }

                                        boxStyle = $"background-color: {containerTypeList.List[0].BoxColor};";
                                        textStyle = $"color: {containerTypeList.List[0].FontColor};";

                                        <div class="gapBottom">
                                            <div class="box-outer" draggable="true" @onmousedown="() => HandleOnMouseDown()"
                                                @ondragstart="@(async () => HandleDragStart(containerTypeList.List[0]))">
                                                <div class="box-top" style="@boxStyle">
                                                    <div class="text-center no-select" style="@textStyle">
                                                        @containerTypeList.List[0].ContainerType
                                                    </div>
                                                </div>
                                                <div class="box-text">
                                                    <div class="text-center no-select">
                                                        XXXX
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        boxStyle = $"background-color: {containerTypeList.List[1].BoxColor};";
                                        textStyle = $"color: {containerTypeList.List[1].FontColor};";

                                        <div class="gapBottom">
                                            <div class="box-outer" draggable="true" @onmousedown="() => HandleOnMouseDown()"
                                                @ondragstart="@(async () => HandleDragStart(containerTypeList.List[1]))">
                                                <div class="box-top" style="@boxStyle">
                                                    <div class="text-center no-select" style="@textStyle">
                                                        @containerTypeList.List[1].ContainerType
                                                    </div>
                                                </div>
                                                <div class="box-text">
                                                    <div class="text-center no-select">
                                                        XXXX
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <PopMsg PopMsgData="@popMsgData" />
    </Authorized>
    <NotAuthorized>
        <span class="spinner-border spinner-border-lg align-center"></span>
        <span> Checking authorization in progress ...........</span>
    </NotAuthorized>
</AuthorizeView>