@using TaskManagerWeb.Components.Pages.Common

@page "/Mattel/OrderKitList"
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject CommonLib CommonLib
@inject HttpClient Http
@inject IJSRuntime jsRuntime
@inject MattelService MattelService
@inject NavigationManager NavigationManager
@inject PaginationService<MattelClass.OrderKit> PaginationService
@inject SortingModel<MattelClass.OrderKit> SortingModel

<style>
    .input {
        margin-right: 20px;
        background-color: rgba(217, 217, 217, 1);
        border-color: black;
        border-radius: 0px;
        width: 230px;
    }

    .label {
        font-size: 20px;
        font-weight: bold;
        color: rgba(110, 113, 115, 1);
        margin-top: 10px;
    }

    .table-set {
        height: 390px;
    }

    .setSVG {
        position: absolute;
        right: 5px;
        top: 13px;
        width: 24px;
        height: 24px;
    }

    .segmentColumn2 {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    .Paging {
        height: 60px;
    }

    .quick {
        position: relative;
        top: 400px;
        left: 20px
    }
</style>

<PageTitle>@CommonParameters.AppName</PageTitle>

<AuthorizeView Roles="Administrator,Engineer,Supervisor">
    <Authorized>
        <div class="outer">
            <div class="contain-size">
                <div class="box1">
                    <h1 id="MyHeader" class="header no-select">
                        Setup Kit Layout
                    </h1>
                </div>
                <div class="box-wrapper">
                    <div class="box2">
                        <div class="segmentColumn gapBottom">
                            <label class="label no-select">Please enter a filter :</label>
                            <div class="segmentRow">
                                <input class="form-control input" maxlength="15" autocomplete="off"
                                    @oninput="(e) => Filter(e!.Value!.ToString()!)" />
                                <button type="button" class="btn btn-sm common-btn gapRight"
                                    @onclick="() => OnClickAdd()">
                                    Add
                                </button>
                                <button type="button" class="btn btn-sm common-btn gapRight" disabled="@disableEdit"
                                    style="@styleEdit" @onclick="() => OnClickEdit()">
                                    Edit
                                </button>
                                <button type="button" class="btn btn-sm common-btn gapRight"
                                    disabled="@disableDuplicate" style="@styleDuplicate"
                                    @onclick="() => OnClickDuplicate()">
                                    Duplicate
                                </button>
                                <button type="button" class="btn btn-sm common-btn gapRight" disabled="@disableView"
                                    style="@styleView" @onclick="() => OnClickView()">
                                    View
                                </button>
                                <button type="button" class="btn btn-sm common-btn" disabled="@disableDelete"
                                    style="@styleDelete" @onclick="() => OnClickDelete()">
                                    Delete
                                </button>
                            </div>
                        </div>
                        <div class="segmentRow">
                            <div class="segmentColumn2">
                                <div class="table-set">
                                    <table class="table scrolldown">
                                        <colgroup>
                                            <col style="width: 150px;">
                                            <col style="width: 150px;">
                                            <col style="width: 150px;">
                                            <col style="width: 150px;">
                                        </colgroup>
                                        <thead>
                                            <tr>
                                                <th class="no-select">
                                                    <div class="segmentRow">
                                                        <div style="margin-left: 8px;">
                                                            Kit Layout
                                                        </div>
                                                        <div class="@(SortingModel.SortIcons["OrderKitNumber"]) setSVG"
                                                            @onclick="@(async () => await SortItems("OrderKitNumber"))" />
                                                    </div>
                                                </th>
                                                <th class="no-select">
                                                    <div class="segmentRow">
                                                        <div style="margin-left: 8px;">
                                                            Layout
                                                        </div>
                                                        <div class="@(SortingModel.SortIcons["LayoutName"]) setSVG"
                                                            @onclick="@(async () => await SortItems("LayoutName"))" />
                                                    </div>
                                                </th>
                                                <th class="no-select">
                                                    <div class="segmentRow">
                                                        <div style="margin-left: 8px;">
                                                            Status
                                                        </div>
                                                        <div class="@(SortingModel.SortIcons["Status"]) setSVG"
                                                            @onclick="@(async () => await SortItems("Status"))" />
                                                    </div>
                                                </th>
                                                <th class="no-select">
                                                    <div class="segmentRow">
                                                        <div style="margin-left: 8px;">
                                                            Date
                                                        </div>
                                                        <div class="@(SortingModel.SortIcons["CreatedData"]) setSVG"
                                                            @onclick="@(async () => await SortItems("CreatedData"))" />
                                                    </div>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (PaginationService.GetItems().Any())
                                            {
                                                foreach (var item in PaginationService.GetItems())
                                                {
                                                    <tr class="@GetRow(item)" @onclick="() => SelectRow(item)">
                                                        <td>
                                                            <div class="no-select">@item.KitNumber</div>
                                                        </td>
                                                        <td>
                                                            <div class="no-select">@item.LayoutName</div>
                                                        </td>
                                                        <td>
                                                            <div class="no-select">@item.Status</div>
                                                        </td>
                                                        <td>
                                                            <div class="no-select">@item.CreatedData.ToString("MM-dd-yyyy")
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="5" class="text-center no-select">
                                                        <div>No data</div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <div class="Paging">
                                    <Pagination T="MattelClass.OrderKit" PaginationService="PaginationService"
                                        OnPageChanged="OnPageChanged" />
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm common-btn quick" style="white-space: nowrap;"
                                @onclick="() => OnClickQuick()">
                                Quick Setup
                            </button>
                        </div>
                    </div>
                </div>
                @if (viewID != 0)
                {
                    <RenderFragmentComponent Content="dynamicComponent!" />
                }
                <EditOrderKit PopEditData="@popEditData" />
                <PopMsg PopMsgData="@popMsgData" />
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <span class="spinner-border spinner-border-lg align-center" />
        <span> Checking authorization in progress ...........</span>
    </NotAuthorized>
</AuthorizeView>