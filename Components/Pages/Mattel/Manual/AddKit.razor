@using TaskManagerWeb.Components.Pages.Common

@page "/Mattel/Manual/AddKit"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject WorkerService WorkerService
@inject MattelService MattelService
@inject IJSRuntime jsRuntime
@inject CommonLib CommonLib
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject PaginationService<MattelClass.SheetData> PaginationService
@inject SortingModel<MattelClass.SheetData> SortingModel

<style>
    .input {
        margin-right: 20px;
        background-color: rgba(217, 217, 217, 1);
        border-color: black;
        border-radius: 0px;
        width: 230px;
        margin-bottom: 20px;
    }

    .label {
        font-size: 20px;
        font-weight: bold;
        color: rgba(110, 113, 115, 1);
        margin-top: 10px;
    }

    .modal-header {
        width: 100%;
        background: rgba(110, 113, 115, 1);
        color: rgba(217, 217, 217, 1);
        padding: 10px;
        font-size: 28px;
        font-weight: bold;
        height: auto;
        position: relative;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .modal-active .top-row,
    .faded-button {
        pointer-events: none;
        opacity: 0.5;
    }

    .active-button {
        opacity: 1;
        pointer-events: auto;
    }

    .table-set {
        height: 390px;

        table {
            th {
                text-align: left;
                padding-left: 10px;
            }
        }
    }

    .setSVG {
        position: absolute;
        right: 5px;
        top: 13px;
        width: 24px;
        height: 24px;
    }

    .segmentColumn2 {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    @* width: 350px; *@
    }

    .Paging {
        height: 60px;
    }
</style>

<PageTitle>@CommonParameters.AppName</PageTitle>

<AuthorizeView Roles="Administrator,Engineer,Supervisor">
    <Authorized>
        <div class="outer">
            <div class="contain-size">
                <div class="box1">
                    <h1 id="MyHeader" class="header no-select">
                        Add New Kit
                    </h1>
                </div>
                <div class="box-wrapper">
                    <div class="box2">
                        <div class="segmentColumn">
                            <div class="segmentRow">
                                <label class="no-select">Please enter New Kit :</label>
                            </div>
                            <div class="segmentRow">
                                <div>
                                    <input @bind="newKitNumber" class="form-control input" @oninput="CheckInput"
                                        maxlength="15" autocomplete="off" />
                                </div>
                                <div class="segmentcolumn">
                                    <div class="segmentRow gapBottom">
                                        <div class="segmentcolumn2 gapRight">
                                            <div class="table-set">
                                                <table class="table scrolldown">
                                                    <colgroup>
                                                        <col style="width: 230px;">
                                                    </colgroup>
                                                    <thead>
                                                        <tr>
                                                            <th>
                                                                <div class="segmentRow">
                                                                    <div class="no-select" style="margin-left: 8px;">
                                                                        Part Number
                                                                    </div>
                                                                    <div class="@(SortingModel.SortIcons["PartNumber"]) setSVG"
                                                                        @onclick="@(async () => await SortItems("PartNumber"))" />
                                                                </div>
                                                            </th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (PaginationService.GetItems().Any())
                                                        {
                                                            foreach (var part in PaginationService.GetItems())
                                                            {
                                                                <tr class="@GetRow(part.PartNumber)"
                                                                    @onclick="() => SelectRow(part.PartNumber)">
                                                                    <td>
                                                                        <div class="no-select">@part.PartNumber</div>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <tr colspan="1" class="text-center no-select">
                                                                <td>
                                                                    <div>No data</div>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                            <div class="Paging">
                                                <Pagination T="MattelClass.SheetData"
                                                    PaginationService="PaginationService"
                                                    OnPageChanged="OnPageChanged" />
                                            </div>
                                        </div>
                                        <div class="segmentColumn">
                                            <button type="button" @onclick="ShowAddPartModal"
                                                class="btn btn-sm common-btn gapBottom" style="@KitButtonColor"
                                                disabled="@string.IsNullOrWhiteSpace(newKitNumber)">
                                                Add Part
                                            </button>
                                            <button type="button" @onclick="ShowEditPartModal"
                                                class="btn btn-sm common-btn gapBottom" style="@PartButtonColor"
                                                disabled="@string.IsNullOrWhiteSpace(selectedPartNumber)">
                                                Edit Part
                                            </button>
                                            <button type="button" @onclick="() => ShowRemovePartModal()"
                                                class="btn btn-sm common-btn" style="@PartButtonColor"
                                                disabled="@string.IsNullOrWhiteSpace(selectedPartNumber)">
                                                Del Part
                                            </button>
                                        </div>
                                    </div>
                                    <div class="segmentRow">
                                        <div class="segmentColumn"
                                            style="@(partNumbers.Count == 0 ? "faded-button" : "active-button")">
                                            <button type="button" @onclick="SaveKit"
                                                class="btn btn-sm common-btn gapRight"
                                                style="@(disableSaveButton ? "background-color: #a5a8a9; border-color: #a5a8a9;" : "background-color: #f36d33; border-color: #f36d33;")"
                                                disabled="@disableSaveButton">
                                                Save
                                            </button>
                                        </div>
                                        <div class="segmentColumn">
                                            <button type="button" @onclick="Cancel" class="btn btn-sm common-btn">
                                                Cancel
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                @if (showModal)
                {
                    <div class="modal-overlay" style="@(showModal ? "display: flex;" : "display: none;")">
                        <div class="modal-content">
                            <div class="modal-header">
                                @if (modalContent == "add")
                                {
                                    <div>Add Part Number</div>
                                }
                                else if (modalContent == "edit")
                                {
                                    <div>Edit Part Number</div>
                                }
                            </div>
                            @if (modalContent == "add")
                            {
                                <AddPart ShowModalChanged="ShowAddModalChanged" OnPartAdded="OnPartAdded" />
                            }
                            else if (modalContent == "edit" && data != null)
                            {
                                <EditPart ShowModalChanged="ShowEditModalChanged" OnPartEdited="OnPartEdited"
                                    EditPartData="@data" />
                            }
                        </div>
                    </div>
                }
                <PopMsg PopMsgData="@popMsgData" />
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <span class="spinner-border spinner-border-lg align-center" />
        <span> Checking authorization in progress ...........</span>
    </NotAuthorized>
</AuthorizeView>