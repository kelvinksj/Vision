@using TaskManagerWeb.Components.Pages.Common

@page "/Mattel/LayoutList"
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject CommonLib CommonLib
@inject HttpClient Http
@inject IJSRuntime jsRuntime
@inject MattelService MattelService
@inject NavigationManager NavigationManager
@inject PaginationService<MattelClass.LayoutData> PaginationService
@inject SortingModel<MattelClass.LayoutData> SortingModel

<style>
    .input {
        margin-right: 20px;
        background-color: rgba(217, 217, 217, 1);
        border-color: black;
        border-radius: 0px;
        width: 230px;
    }

    .label {
        font-size: 20x;
        font-weight: bold;
        color: rgba(110, 113, 115, 1);
        margin-top: 10px;
    }

    .table-set {
        height: 390px;
    }

    .setSVG {
        position: absolute;
        right: 1px;
        top: 13px;
        width: 24px;
        height: 24px;
    }

    .segmentColumn2 {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    @* width: 350px; *@
    }

    .Paging {
        height: 60px;
    }
</style>

<PageTitle>@CommonParameters.AppName</PageTitle>

<AuthorizeView Roles="Administrator,Engineer,Supervisor">
    <Authorized>
        <div class="outer">
            <div class="contain-size">
                <div class="box1">
                    <h1 id="MyHeader" class="header no-select">
                        Setup Layout
                    </h1>
                </div>
                <div class="box-wrapper">
                    <div class="box2">
                        <div class="segmentColumn gapBottom">
                            <label class="label no-select">Please enter a filter :</label>
                            <div class="segmentRow">
                                <input class="form-control input" maxlength="15" autocomplete="off"
                                    @oninput="(e) => Filter(e!.Value!.ToString()!)" />
                                <button type="button" class="btn btn-sm common-btn gapRight"
                                    @onclick="() => OnClickAdd()">
                                    Add
                                </button>
                                <button type="button" class="btn btn-sm common-btn gapRight" style="@disableStyle"
                                    disabled="@disableBtn" @onclick="() => OnClickEdit()">
                                    Edit
                                </button>
                                <button type="button" class="btn btn-sm common-btn" style="@disableStyle"
                                    disabled="@disableBtn" @onclick="() => OnClickDelete()">
                                    Delete
                                </button>
                            </div>
                        </div>
                        <div class="segmentColumn2 gapRight">
                            <div class="table-set">
                                <table class="table scrolldown">
                                    <colgroup>
                                        <col style="width: 200px;">
                                        <col style="width: 150px;">
                                        <col style="width: 150px;">
                                        <col style="width: 150px;">
                                        <col style="width: 150px;">
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th class="no-select">
                                                <div class="segmentRow">
                                                    <div style="margin-left: 8px;">
                                                        Layout Name
                                                    </div>
                                                    <div class="@(SortingModel.SortIcons["LayoutName"]) setSVG"
                                                        @onclick="@(async () => await SortItems("LayoutName"))" />
                                                </div>
                                            </th>
                                            <th class="no-select">
                                                <div class="segmentRow">
                                                    <div style="margin-left: 8px;">
                                                        Type
                                                    </div>
                                                    <div class="@(SortingModel.SortIcons["LayoutTypeName"]) setSVG"
                                                        @onclick="@(async () => await SortItems("LayoutTypeName"))" />
                                                </div>
                                            </th>
                                            <th class="no-select">
                                                <div class="header-wrapper segmentRow">
                                                    <div>
                                                        SKU
                                                    </div>
                                                    <div class="@(SortingModel.SortIcons["countSKU"]) setSVG"
                                                        @onclick="@(async () => await SortItems("countSKU"))" />
                                                </div>
                                            </th>
                                            <th class="no-select">
                                                <div class="header-wrapper segmentRow">
                                                    <div>
                                                        GL
                                                    </div>
                                                    <div class="@(SortingModel.SortIcons["countGL"]) setSVG"
                                                        @onclick="@(async () => await SortItems("countGL"))" />
                                                </div>
                                            </th>
                                            <th class="no-select">
                                                <div class="header-wrapper segmentRow">
                                                    <div>
                                                        FG
                                                    </div>
                                                    <div class="@(SortingModel.SortIcons["countFG"]) setSVG"
                                                        @onclick="@(async () => await SortItems("countFG"))" />
                                                </div>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (PaginationService.GetItems().Any())
                                        {
                                            foreach (var item in PaginationService.GetItems())
                                            {
                                                <tr class="@GetRow(item)" @onclick="() => SelectRow(item)">
                                                    <td>
                                                        <div class="no-select">
                                                            @item.LayoutName
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="no-select">
                                                            @item.LayoutTypeName
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="no-select" style="text-align: center;">
                                                            @item.countSKU
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="no-select" style="text-align: center;">
                                                            @item.countGL
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="no-select" style="text-align: center;">
                                                            @item.countFG
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="5" class="text-center no-select">
                                                    <div>No data</div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="Paging">
                                <Pagination T="MattelClass.LayoutData" PaginationService="PaginationService"
                                    OnPageChanged="OnPageChanged" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <PopMsg PopMsgData="@popMsgData" />
    </Authorized>
    <NotAuthorized>
        <span class="spinner-border spinner-border-lg align-center" />
        <span> Checking authorization in progress ...........</span>
    </NotAuthorized>
</AuthorizeView>