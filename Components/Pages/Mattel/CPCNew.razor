@using TaskManagerWeb.Components.Pages.Common

@page "/Mattel/CPCNew"
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject CommonLib CommonLib
@inject ContainerService ContainerService
@inject HttpClient Http
@inject IJSRuntime jsRuntime
@inject MattelService MattelService
@inject NavigationManager NavigationManager
@inject TaskManagerService TaskManagerService

<style>
    .icon_cancel_orange {
        height: 50px;
        width: 50px;
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
        cursor: pointer;
    }

    .icon-box-wrapper {
        height: auto;
        width: auto;
        display: flex;
        flex-direction: column;
        flex-wrap: wrap;
        justify-content: center;
        align-content: center;
    }

    .custom-select-wrapper {
        position: relative;
        display: inline-block;

        .custom-select {
            width: 130px;
            outline: none !important;
        }

        .custom-select-arrow {
            position: absolute;
            left: 100px;
            top: 6px;
            pointer-events: none;
        }
    }

    .icon_warning_triangle_red {
        width: 40px;
        height: 40px;
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
    }

    .msglist {
        --msg-height: 500px !important;
    }
</style>

<PageTitle>@CommonParameters.AppName</PageTitle>

<AuthorizeView Roles="Administrator,Engineer,Supervisor,Operator">
    <Authorized>
        <div class="outer">
            <div class="contain-size">
                <div class="segmentColumn">
                    <div class="box1 gapBottom">
                        <h1 id="MyHeader" class="header no-select">
                            Checkpoint Charlie
                        </h1>
                    </div>
                    <div class="segmentRow gapBottom" style="display: none;">
                        <div class="icon_warning_triangle_red gapRight" />
                        <div style="font-size: 24px; color: red;">
                            Please click the icon below to take action
                        </div>
                    </div>
                    <div class="box-wrapper">
                        <div class="box2">
                            <div class="segmentRow gapBottom">
                                <button type="button" class="btn btn-sm common-btn" @onclick="() => OnClickLine(1)">
                                    Lane 1 & 2
                                </button>
                                <button type="button" class="btn btn-sm common-btn gapLeft"
                                    @onclick="() => OnClickLine(2)">
                                    Lane 3 & 4
                                </button>
                                <button type="button" class="btn btn-sm common-btn gapLeft"
                                    @onclick="() => OnClickLine(3)">
                                    Lane 5 & 6
                                </button>
                                @if (!isOperator)
                                {
                                    if (!cPCSetup.IsLineEdit)
                                    {
                                        <button type="button" class="btn btn-sm common-btn"
                                            style="position: relative; left: 250px;" @onclick="() => OnClickSetting()">
                                            Setting
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm common-btn"
                                            style="position: relative; left: 250px;" @onclick="() => OnClickSave()">
                                            Save
                                        </button>
                                    }
                                }
                            </div>
                            <div class="segmentRow">
                                <div class="segmentColumn">
                                    <div class=" gapRight">
                                        <RenderFragmentComponent Content="dynamicComponent!" />
                                    </div>
                                </div>
                                <div>
                                    <MsgList MList="@mList" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <PopContainer PopContainerData="@popContainerData" />
        <PopMsg PopMsgData="@popMsgData" />
    </Authorized>
    <NotAuthorized>
        <span class="spinner-border spinner-border-lg align-center" />
        <span> Checking authorization in progress ...........</span>
    </NotAuthorized>
</AuthorizeView>
