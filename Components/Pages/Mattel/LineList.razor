@using TaskManagerWeb.Components.Pages.Common

@page "/Mattel/LineList"
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject CommonLib CommonLib
@inject HttpClient Http
@inject IJSRuntime jsRuntime
@inject MattelService MattelService
@inject NavigationManager NavigationManager
@inject PaginationService<MattelClass.ProductionData> PaginationService
@inject SortingModel<MattelClass.ProductionData> SortingModel

<style>
    .input {
        margin-right: 20px;
        background-color: rgba(217, 217, 217, 1);
        border-color: black;
        border-radius: 0px;
        width: 180px;
    }

    .btn-view {
    @bgColor_View
    @borderColor_View
    }

    .btn-assign {
    @bgColor_Assign
    @borderColor_Assign
    }

    .btn-clear {
    @bgColor_Clear
    @borderColor_Clear
    }

    .table-set {
        height: 320px;
        overflow-x: hidden;
        overflow-y: hidden;
    }

    .setSVG {
        position: absolute;
        right: 5px;
        top: 13px;
        width: 24px;
        height: 24px;
    }
</style>

<PageTitle>@CommonParameters.AppName</PageTitle>

<AuthorizeView Roles="Administrator,Engineer,Supervisor">
    <Authorized>
        <div class="outer">
            <div class="contain-size">
                <div class="box1">
                    <h1 id="MyHeader" class="header no-select">
                        Setup Line
                    </h1>
                </div>
                <div class="box-wrapper">
                    <div class="box2">
                        <div>
                            <div class="segmentRow gapBottom">
                                <div class="segmentRow" style="margin-top: 25px;">
                                    <button type="button" class="btn btn-sm common-btn btn-view"
                                        @onclick="() => OnClickView()" disabled="@disableView">
                                        View
                                    </button>
                                    <button type="button" class="btn btn-sm common-btn btn-assign gapLeft"
                                        @onclick="() => OnClickAssign()" disabled="@disableAssign">
                                        Assign
                                    </button>
                                    <button type="button" class="btn btn-sm common-btn btn-clear gapLeft"
                                        @onclick="() => OnClickClear()" disabled="@disableClear">
                                        Clear
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="table-set">
                            <table class="table scrolldown">
                                <colgroup>
                                    <col style="width: 150px;">
                                    <col style="width: 150px;">
                                    <col style="width: 150px;">
                                    <col style="width: 150px;">
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th class="no-select">
                                            <div class="segmentRow">
                                                <div style="margin-left: 8px;">
                                                    Line Name
                                                </div>
                                                <div class="@(SortingModel.SortIcons["LineName"]) setSVG"
                                                    @onclick="@(async () => await SortItems("LineName"))" />
                                            </div>
                                        </th>
                                        <th class="no-select">
                                            <div class="segmentRow">
                                                <div style="margin-left: 8px;">
                                                    Kit Layout
                                                </div>
                                                <div class="@(SortingModel.SortIcons["OrderKitNumber"]) setSVG"
                                                    @onclick="@(async () => await SortItems("OrderKitNumber"))" />
                                            </div>
                                        </th>
                                        <th class="no-select">
                                            <div class="segmentRow">
                                                <div style="margin-left: 8px;">
                                                    Status
                                                </div>
                                                <div class="@(SortingModel.SortIcons["Status"]) setSVG"
                                                    @onclick="@(async () => await SortItems("Status"))" />
                                            </div>
                                        </th>
                                        <th class="no-select">
                                            <div class="segmentRow">
                                                <div style="margin-left: 8px;">
                                                    Date
                                                </div>
                                                <div class="@(SortingModel.SortIcons["CreatedData"]) setSVG"
                                                    @onclick="@(async () => await SortItems("CreatedData"))" />
                                            </div>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (PaginationService.GetItems() != null && PaginationService.GetItems().Any())
                                    {
                                        @foreach (var item in PaginationService.GetItems())
                                        {
                                            <tr class="@GetRow(item)" @onclick="() => SelectRow(item)">
                                                <td>
                                                    <div class="no-select">@item.LineName</div>
                                                </td>
                                                <td>
                                                    <div class="no-select">@item.OrderKitNumber</div>
                                                </td>
                                                <td>
                                                    <div class="no-select">@item.Status</div>
                                                </td>
                                                <td>
                                                    <div class="no-select">
                                                        @item.CreatedData.ToString("MM-dd-yyyy")
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center no-select">
                                                <div>No data</div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                @if (viewID != 0)
                {
                    <RenderFragmentComponent Content="dynamicComponent!" />
                }
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <span class="spinner-border spinner-border-lg align-center" />
        <span> Checking authorization in progress ...........</span>
    </NotAuthorized>
</AuthorizeView>