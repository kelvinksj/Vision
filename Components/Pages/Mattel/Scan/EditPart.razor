@page "/Mattel/Scan/EditPart"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject WorkerService WorkerService
@inject ScreenWakeLockService ScreenWakeLockService
@inject CommonLib CommonLib
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime jsRuntime
@inject MattelService MattelService

<style>
    .form {
        display: flex;
        justify-content: center;
        margin: 10px;
    }

    .label-to-input {
        color: rgba(110, 113, 115, 1);
        font-size: 16px;
        font-weight: bold;
    }

    .input-style {
        width: 250px;
        background-color: rgba(217, 217, 217, 1);
        border-bottom: none;
    }

    .button {
        width: 100%;
        display: flex;
        justify-content: center;
    }

    .button-confirm,
    .button-cancel {
        background-color: rgba(243, 109, 51, 1);
        border-color: rgba(243, 109, 51, 1);
        color: white;
        border-radius: 30px;
        font-size: 20px;
        font-weight: bold;
        width: 130px;
        height: 50px;
        margin: 10px;
    }

    .validation-message {
        color: red;
        font-size: 0.9em;
        margin-top: 5px;
    }

    .modal-overlay {
        display: flex;
        justify-content: center;
        align-items: center;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1000;
    }

    .modal-content {
        background: white;
        width: 400px;
        height: auto;
        min-width: fit-content;
        position: relative;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
</style>

<PageTitle>@CommonParameters.AppName</PageTitle>

<div class="box2">
    <div class="segmentColumn">
        <EditForm Model="@EditPartData" OnValidSubmit="Confirm" autocomplete="off" Context="editContext">
            <DataAnnotationsValidator />
            <div class="form-row form">
                <div>
                    <label class="label-to-input">Current Value</label>
                    <input class="form-control input-style" maxlength="15" value="@CurrentPart" disabled />
                </div>
            </div>
            <div class="form-row form">
                <div>
                    <label class="label-to-input">New Value</label>
                    <input @bind="NewPart" class="form-control input-style" @oninput="CheckInput" maxlength="15"
                        autocomplete="off" />
                </div>
            </div>
        </EditForm>
        <div class="form-group button">
            <button type="button" @onclick="Confirm" class="btn button-confirm" style="@ConfirmButtonColor"
                disabled="@string.IsNullOrWhiteSpace(EditPartData.PartNumber)">
                Confirm
            </button>
            <button type="button" @onclick="CloseModal" class="btn button-cancel">Cancel</button>
        </div>
    </div>
</div>