@using TaskManagerWeb.Components.Pages.Common

@page "/Mattel/Scan/ScanAll"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject WorkerService WorkerService
@inject ScreenWakeLockService ScreenWakeLockService
@inject CommonLib CommonLib
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime jsRuntime
@inject MattelService MattelService
@inject PaginationService<MattelClass.Sheet> KitPaginationService
@inject PaginationService<MattelClass.SheetData> PartPaginationService
@inject SortingModel<MattelClass.Sheet> KitSortingModel
@inject SortingModel<MattelClass.SheetData> PartSortingModel
@inject ScanService ScanService

<style>
    .input {
        margin-right: 20px;
        background-color: rgba(217, 217, 217, 1);
        border-color: black;
        border-radius: 0px;
        width: 230px;
        margin-bottom: 20px;
    }

    .button {
        width: 100%;
        display: flex;
        justify-content: center;
        margin: 10px;
    }

    .table-set {
        height: 390px;

        table {
            th {
                text-align: left;
                padding-left: 10px;
            }
        }
    }

    .setSVG {
        position: absolute;
        right: 5px;
        top: 13px;
        width: 24px;
        height: 24px;
    }

    .msglist {
        --msg-height: 180px !important;
    }

    .segmentColumn2 {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    @* width: 350px; *@
    }

    .Paging {
        height: 60px;
    }
</style>

<PageTitle>@CommonParameters.AppName</PageTitle>

<AuthorizeView Roles="Administrator,Engineer,Supervisor">
    <Authorized>
        <div class="outer">
            <div class="contain-size">
                <div class="box1">
                    <h1 class="header no-select">
                        Setup Kit - Scan All Raw Data
                    </h1>
                </div>
                <div class="box-wrapper">
                    <div class="box2">
                        <div class="segmentColumn" style="margin-top: 10px;">
                            <div class="segmentRow gapBottom">
                                <button type="button" @onclick="() => OnClickScan()"
                                    class="btn btn-sm common-btn gapRight" style="@disableStyleScan"
                                    disabled="@disableScan">
                                    Scan All
                                </button>
                                <div class="gapRight" />
                                <button type="button"
                                    @onclick="() => { if (!string.IsNullOrWhiteSpace(selectedKitNumber)) Manage(); }"
                                    class="btn btn-sm common-btn" style="@KitButtonColor">
                                    Manage
                                </button>
                            </div>
                            <div class="segmentRow">
                                <div class="segmentColumn2">
                                    <div class="table-set gapRight">
                                        <table class="table scrolldown">
                                            <colgroup>
                                                <col style="width: 220px;">
                                            </colgroup>
                                            <thead>
                                                <tr>
                                                    <th>
                                                        <div class="segmentRow">
                                                            <div style="margin-left: 8px;">Kit #</div>
                                                            <div class="@(KitSortingModel.SortIcons["KitNumber"]) setSVG"
                                                                @onclick="@(async () => await SortItems("KitNumber"))" />
                                                        </div>
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (KitPaginationService.GetItems().Any())
                                                {
                                                    foreach (var sheet in KitPaginationService.GetItems())
                                                    {
                                                        <tr class="@(selectedKitNumber == sheet.KitNumber ? "row-active" : "")"
                                                            @onclick="() => SelectKit(sheet.KitNumber)">
                                                            <td>
                                                                <div>@sheet.KitNumber</div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="1" class="text-center no-select">
                                                            <div>No data</div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="Paging">
                                        <Pagination T="MattelClass.Sheet" PaginationService="KitPaginationService"
                                            OnPageChanged="OnPageChanged" />
                                    </div>
                                </div>
                                <div class="segmentColumn2 gapRight">
                                    <div class="table-set gapLeft">
                                        <table class="table scrolldown">
                                            <colgroup>
                                                <col style="width: 230px;">
                                                <col style="width: 230px;">
                                            </colgroup>
                                            <thead>
                                                <tr>
                                                    <th>
                                                        <div class="segmentRow">
                                                            <div style="margin-left: 8px;">Part #</div>
                                                            <div class="@(PartSortingModel.SortIcons["PartNumber"]) setSVG"
                                                                @onclick="@(async () => await SortItems("PartNumber"))" />
                                                        </div>
                                                    </th>
                                                    <th>
                                                        <div class="segmentRow">
                                                            <div style="margin-left: 8px;">Description</div>
                                                            <div class="@(PartSortingModel.SortIcons["Description"]) setSVG"
                                                                @onclick="@(async () => await SortItems("Description"))" />
                                                        </div>
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (selectedSheet != null && PartPaginationService.GetItems().Any())
                                                {
                                                    @foreach (var part in PartPaginationService.GetItems())
                                                    {
                                                        <tr>
                                                            <td>
                                                                <div>@part.PartNumber</div>
                                                            </td>
                                                            <td>
                                                                <div>@part.Description</div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="2" class="text-center no-select">
                                                            <div>No data</div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="Paging">
                                        <Pagination T="MattelClass.SheetData" PaginationService="PartPaginationService"
                                            OnPageChanged="OnPageChanged2" />
                                    </div>
                                </div>
                                <div class="segmentColumn" style="margin-top: -80px;">
                                    <div>
                                        <MsgList MList="@mList" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <PopMsg PopMsgData="@popMsgData" />
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <span class="spinner-border spinner-border-lg align-center"></span>
        <span> Checking authorization in progress ...........</span>
    </NotAuthorized>
</AuthorizeView>