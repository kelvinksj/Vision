@page "/Setting/Settings"
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject CommonLib CommonLib
@inject HttpClient HttpClient
@inject IJSRuntime jsRuntime
@inject NavigationManager NavigationManager
@inject MattelService MattelService
@inject SettingsService SettingsService
@inject ScreenWakeLockService ScreenWakeLockService
@inject WorkerService WorkerService

<style>
    .settings-style {
        .box-wrapper {
            justify-content: start;
        }

        .form-to-button {
            margin-bottom: 10px;
        }

        .input-to-input {
            display: flex;
            align-items: center;
            margin-bottom: 10px;
        }

        .label-to-input {
            width: 90px;
            margin-right: 10px;
        }

        .input-style {
            margin-right: 10px;
            width: 150px;
        }
    }
</style>

<PageTitle>@CommonParameters.AppName</PageTitle>

<AuthorizeView Roles="Administrator,Engineer">
    <Authorized>
        <div class="settings-style outer">
            <div class="contain-size">
                <div class="box1">
                    <h1 id="MyHeader" class="header no-select">
                        Settings
                    </h1>
                </div>
                <div class="box-wrapper">
                    <div class="box2">
                        <div class="gapBottom" />
                        <label class="header no-select" style="font-size: 24px;">
                            IP Settings
                        </label>
                        <div style="margin-bottom: 5px;" />
                        <EditForm Model="@info" OnValidSubmit="() => OnValidSubmit(info)" Context="editContext">
                            <DataAnnotationsValidator />
                            <div class="segmentColumn gapBottom">
                                <div class="segmentRow gapBottom">
                                    <div class="segmentColumn">
                                        <label class="gapRight">UI Manager IP :</label>
                                        <InputText @bind-Value="info.MyNetData.IP" class="form-control input-style" />
                                        <ValidationMessage For="() => info.MyNetData.IP" />
                                    </div>
                                    <div class="gapRight" />
                                    <div class="gapRight" />
                                    <div class="segmentColumn">
                                        <label class="gapRight">Scan Manager IP :</label>
                                        <InputText @bind-Value="info.ScanNetData.IP" class="form-control input-style" />
                                        <ValidationMessage For="() => info.ScanNetData.IP" />
                                    </div>
                                </div>
                                <div class="segmentRow gapBottom">
                                    <div class="segmentColumn">
                                        <label class="gapRight">Task Manager IP :</label>
                                        <InputText @bind-Value="info.TaskManagerNetData.IP"
                                            class="form-control input-style" />
                                        <ValidationMessage For="() => info.TaskManagerNetData.IP" />
                                    </div>
                                    <div class="gapRight" />
                                    <div class="gapRight" />
                                    <div class="segmentColumn">
                                        <label class="gapRight">RCS Server IP :</label>
                                        <InputText @bind-Value="info.RCSNetData.IP" class="form-control input-style" />
                                        <ValidationMessage For="() => info.RCSNetData.IP" />
                                    </div>
                                    <div class="gapRight" />
                                    <div class="gapRight" />
                                    <div class="segmentColumn">
                                        <label class="gapRight">RCS Map ID :</label>
                                        <InputNumber @bind-Value="info.RCSData.MapId" class="form-control input-style"
                                            Min="1" Max="99999" maxlength="2" />
                                        <ValidationMessage For="() => info.RCSData.MapId" />
                                    </div>
                                </div>
                                <div class="segmentRow gapBottom">
                                    <div class="segmentColumn">
                                        <label class="gapRight">Container Manager IP :</label>
                                        <div class="segmentRow">
                                            <InputText @bind-Value="info.ContainerNetData.IP"
                                                class="form-control input-style" />
                                            <ValidationMessage For="() => info.ContainerNetData.IP" />
                                            <div class="gapRight" />
                                            <div class="gapRight" />
                                            <button type="button" @onclick="() => SetDefault(info)"
                                                disabled="@info.IsBusy" class="btn btn-sm common-btn">
                                                Restore
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="segmentRow">
                                <button type="submit" disabled="@info.IsBusy" class="btn btn-sm common-btn">
                                    Save
                                </button>
                                <div class="gapRight" />
                                <button type="button" @onclick="() => EditCancel()" disabled="@info.IsBusy"
                                    class="btn btn-sm common-btn">
                                    Cancel
                                </button>
                            </div>
                            <div class="segmentColumn">
                                <div class="gapBottom" />
                                <div class="gapBottom" />
                                <label class="header no-select" style="font-size: 24px;">
                                    Line Reset Status
                                </label>
                                <div style="margin-bottom: 5px;" />
                                <div class="segmentRow">
                                    <div class="segmentColumn gapRight">
                                        <label class="gapRight" style="margin-bottom: 5px;">Line 1</label>
                                        <button type="button" class="btn btn-sm common-btn"
                                            @onclick="() => OnClickReset(1)">
                                            Reset
                                        </button>
                                    </div>
                                    <div class="gapRight" />
                                    <div class="segmentColumn gapRight">
                                        <label class="gapRight" style="margin-bottom: 5px;">Line 2</label>
                                        <button type="button" class="btn btn-sm common-btn"
                                            @onclick="() => OnClickReset(2)">
                                            Reset
                                        </button>
                                    </div>
                                    <div class="gapRight" />
                                    <div class="segmentColumn gapRight">
                                        <label class="gapRight" style="margin-bottom: 5px;">Line 3</label>
                                        <button type="button" class="btn btn-sm common-btn"
                                            @onclick="() => OnClickReset(3)">
                                            Reset
                                        </button>
                                    </div>
                                    <div class="gapRight" />
                                    <div class="segmentColumn gapRight">
                                        <label class="gapRight" style="margin-bottom: 5px;">Line 4</label>
                                        <button type="button" class="btn btn-sm common-btn"
                                            @onclick="() => OnClickReset(4)">
                                            Reset
                                        </button>
                                    </div>
                                    <div class="gapRight" />
                                    <div class="segmentColumn gapRight">
                                        <label class="gapRight" style="margin-bottom: 5px;">Line 5</label>
                                        <button type="button" class="btn btn-sm common-btn"
                                            @onclick="() => OnClickReset(5)">
                                            Reset
                                        </button>
                                    </div>
                                    <div class="gapRight" />
                                    <div class="segmentColumn">
                                        <label class="gapRight" style="margin-bottom: 5px;">Line 6</label>
                                        <button type="button" class="btn btn-sm common-btn"
                                            @onclick="() => OnClickReset(6)">
                                            Reset
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <span class="spinner-border spinner-border-lg align-center"></span>
        <span> Checking authorization in progress ...........</span>
    </NotAuthorized>
</AuthorizeView>