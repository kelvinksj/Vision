@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject CommonLib CommonLib
@inject IDataProtectionProvider DataProtectionProvider
@inject IHttpClientFactory HttpClientFactory
@inject HttpClient HttpClient
@inject IJSRuntime jsRuntime
@inject KeepAliveService KeepAliveService
@inject NavigationManager NavigationManager
@inject MessageService MessageService
@inject ScreenWakeLockService ScreenWakeLockService
@inject SettingsService SettingsService
@inject UserAccountService UserAccountService
@inject WorkerService WorkerService

<style>
    .page {
        display: flex;
        position: relative;
        flex-direction: row;
    }

    main {
        flex: auto;
    }

    .sidebar {
        background-image: linear-gradient(180deg, rgb(5, 39, 103) 0%, #3a0647 70%);
    }

    .top-row {
        position: fixed;
        bottom: 0;
        width: 100%;
        height: 100px;
        background-color: white;
        color: white;
        text-align: center;
    }

    .top-row ::deep a,
    .top-row ::deep .btn-link {
        white-space: nowrap;
        margin-left: 1.5rem;
        text-decoration: none;
    }

    .top-row ::deep a:hover,
    .top-row ::deep .btn-link:hover {
        text-decoration: underline;
    }

    .top-row ::deep a:first-child {
        overflow: hidden;
        text-overflow: ellipsis;
    }

    #blazor-error-ui {
        background: lightyellow;
        bottom: 0;
        box-shadow: 0 -1px 2px rgba(0, 0, 0, 0.2);
        display: none;
        left: 0;
        padding: 0.6rem 1.25rem 0.7rem 1.25rem;
        position: fixed;
        width: 100%;
        z-index: 1000;
    }

    #blazor-error-ui .dismiss {
        cursor: pointer;
        position: absolute;
        right: 0.75rem;
        top: 0.5rem;
    }

    .logoBottom {
        width: 130px;
        height: 60px;
        margin: 5px;
    }

    .body {
        margin: 0;
        padding: 0;
    }

    article {
        padding: none;
    }

    .icon_line {
        display: inline-block;
        width: 100%;
        height: 5px;
        background-size: cover;
    }

    .icon_setSVG {
        display: inline-block;
        width: 50px;
        height: 50px;
        margin: 5px;
        background-size: contain;
        background-repeat: no-repeat;
        cursor: pointer;
    }

    .bottom-bar {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 20px;
    }

    .modal-overlay {
        display: flex;
        justify-content: center;
        align-items: center;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1000;
    }

    .modal-content {
        background: white;
        width: 30%;
        height: auto;
        min-width: fit-content;
        position: relative;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .modal-header {
        width: 100%;
        background: grey;
        color: white;
        padding: 10px;
        font-size: 28px;
        height: auto;
        position: relative;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .modal-active .top-row {
        pointer-events: none;
        opacity: 0.5;
    }

    .greetUser {
        position: absolute;
        top: -10px;
        left: 10px;
        font-size: 14px;
        color: rgba(243, 109, 51, 1);
    }

    .version {
        position: absolute;
        top: -10px;
        right: 10px;
        font-size: 14px;
        color: rgba(243, 109, 51, 1);
    }

    /* Styles for Samsung Galaxy Note10+ */
    /*@@media only screen and (min-width: 412px) and (max-width: 869px) {
        .scale2 {
            transform: scale(45%);
            transform-origin: top left;
        }
    }*/

    /* Styles for Samsung Galaxy Note10+ */
    /*@@media only screen and (min-width: 412px) and (max-width: 869px) and (orientation: landscape) {
        .scale2 {
            transform: scale(35%);
            transform-origin: top left;
        }
    }*/

    /* Desktop */
    /*@@media (min-width: 1024.01px) {
        .page {
            flex-direction: row;
        }

        .sidebar {
            width: 250px;
            height: 100vh;
            position: sticky;
            top: 0;
        }

        .top-row.auth ::deep a:first-child {
            flex: 1;
            text-align: right;
            width: 0;
        }

        .top-row,
        article {
            padding-left: 2rem;
            padding-right: 1.5rem;
        }

        .scale2 {
            transform: scale(80%);
            transform-origin: top left;
        }
    }*/

    /* iPad */
    /*@@media screen and (min-device-width: 768px) and (max-device-width: 819px) and (orientation: portrait) {
        .page {
            flex-direction: row;
        }

        .sidebar {
            width: 250px;
            height: 100vh;
            position: sticky;
            top: 0;
        }

        .top-row.auth ::deep a:first-child {
            flex: 1;
            text-align: right;
            width: 0;
        }

        .top-row,
        article {
            padding-left: 4rem;
            padding-right: 1.5rem;
        }

        .scale2 {
            transform: scale(70%);
            transform-origin: top left;
        }
    }*/

    /* iPad */
    /*@@media screen and (min-device-width: 768px) and (max-device-width: 819px) and (orientation: landscape) {
        .page {
            flex-direction: row;
        }

        .sidebar {
            width: 250px;
            height: 100vh;
            position: sticky;
            top: 0;
        }

        .top-row.auth ::deep a:first-child {
            flex: 1;
            text-align: right;
            width: 0;
        }

        .top-row,
        article {
            padding-left: 4rem;
            padding-right: 1.5rem;
        }

        .scale2 {
            transform: scale(75%);
            transform-origin: top left;
        }
    }*/
</style>

<div class="page">
    <main>
        <div class="body">
            <CascadingValue Value="pageGuid">
                <article class="px-2">
                    @Body
                </article>
            </CascadingValue>
        </div>
        <div class="top-row px-1">
            @if (!string.IsNullOrEmpty(currentUserName))
            {
                <div class="greetUser no-select">
                    @currentUserName ( @currentUserRole )
                </div>
                <div class="version no-select">
                    @softwareVersion
                </div>
            }
            <div class="icon_line" />
            <div class="bottom-bar">
                <AuthorizeView Roles="Administrator,Engineer,Supervisor,Operator">
                    <Authorized>
                        @{
                            var hideHtml = "";

                            if (IsHomePage())
                            {
                                hideHtml = "display: none";
                            }
                        }
                        <div class="icon_arrow_back icon_setSVG" style="@hideHtml" @onclick="GoBack" />
                        <div class="icon_signout_darkgrey icon_setSVG" @onclick="Navigate1" />
                        <div class="icon_risk_management_darkgrey icon_setSVG" @onclick="Navigate2" />

                        @if (accessPage == "CI")
                        {
                            <div class="icon_forklift_darkgrey icon_setSVG" @onclick="Navigate7" />
                        }
                        else if (accessPage == "CO")
                        {
                            <div class="icon_sequence_darkgrey icon_setSVG" @onclick="Navigate7" />
                        }
                        else if (accessPage == "CPC")
                        {
                            <div class="icon_goods_darkgrey icon_setSVG" @onclick="Navigate7" />
                        }
                        else if (accessPage == "GL")
                        {
                            <div class="icon_recycle_darkgrey icon_setSVG" @onclick="Navigate7" />
                        }
                        else
                        {
                            <div class="icon_assembly_line_darkgrey icon_setSVG" @onclick="Navigate7" />
                        }

                        <img class="logoBottom no-select" style="cursor: pointer;" src="images/DallasRoboterLogo.png"
                            @onclick="Navigate0" />
                        @if (!isOperator)
                        {
                            <div class="icon_program_darkgrey icon_setSVG" @onclick="Navigate3" />
                            <div class="icon_barcode_scanner_darkgrey icon_setSVG" @onclick="Navigate4" />
                            <div class="icon_link_darkgrey icon_setSVG" @onclick="Navigate5" />
                            <div class="icon_manufacturing_darkgrey icon_setSVG" @onclick="Navigate6" />
                        }
                    </Authorized>
                    <NotAuthorized>
                        <div class="icon_signin_darkgrey icon_setSVG" @onclick="ShowSigninModal" />
                        <img class="logoBottom no-select" src="images/DallasRoboterLogo.png" />
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
        <div class="modal-overlay" style="@(showModal ? "display: flex;" : "display: none;")">
            <div class="modal-content">
                <div class="modal-header no-select" style="font-size: 28px;">Login</div>
                <Login ShowModalChanged="ShowModalChanged" />
            </div>
        </div>
    </main>
</div>