@page "/"
@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager Nav
@inject MediaState MediaState
@inject AppSettingsState Settings
@using Newtonsoft.Json
@using System.Text.Json

@if (ShowNotice)
{
    <div class="notice-bar @NoticeCss">
        @NoticeMessage
    </div>
}

<h3>Camera Live Feed</h3>

@if (!Settings.HasCamera)
{
    <p class="text-red-600 italic">
        ⚠ No default camera selected. Please configure it in the <a href="/settings" class="underline text-blue-600">Settings</a>.
    </p>
}
else
{
    <p class="text-sm text-gray-600">
        🎥 Camera: <b>@Settings.CameraLabel</b>
    </p>
}

<div class="flex items-center gap-2 text-sm mt-2">
    <span class="font-medium">🧩 Detection Type:</span>
    <select class="border rounded px-2 py-1 text-sm"
            @bind="detectionType"
            disabled="@IsRecording">
        <option value="rect">Rectangles/Squares</option>
        <option value="circle">Circles</option>
        <option value="qr">QR/Barcodes</option>
        <option value="custom">Custom</option>
    </select>
</div>

@if (IsRecording)
{
    <div class="record-status">
        🔴 Recording... <span>@RecordingTimeDisplay</span>
    </div>
}

<div class="video-container" style="position:relative; width:640px;">

    <!-- Placeholder if no camera selected -->
    <div class="video-placeholder @(string.IsNullOrEmpty(selectedCamera) ? "fade-in" : "fade-out")">
        📷 Please select a camera to start...
    </div>

    <!-- Video & canvas wrapper -->
    <div style="position:relative; width:640px; height:480px;">
        <video id="videoElement"
               class="@(string.IsNullOrEmpty(selectedCamera) ? "hidden" : "fade-in")"
               autoplay playsinline width="640" height="480"
               style="position:absolute; top:0; left:0; z-index:1;"></video>

        <!-- hidden capture canvas -->
        <canvas id="captureCanvas" width="640" height="480" style="display:none"></canvas>

        <!-- overlay canvas -->
        <canvas id="overlayCanvas" width="640" height="480"
                style="position:absolute; top:0; left:0; z-index:3; pointer-events:auto;"></canvas>
    </div>

    <!-- All action buttons together -->
    <div class="mt-3 d-flex flex-wrap gap-2">
        <button class="btn btn-primary" @onclick="TakePhoto" disabled="@IsRecording">📸 Take Photo</button>
        <button class="btn btn-success" @onclick="StartRecording" disabled="@IsRecording">⏺️ Start Recording</button>
        @if (IsRecording && !IsPaused)
        {
            <button class="btn btn-warning" @onclick="PauseRecording">⏸️ Pause</button>
        }
        @if (IsRecording && IsPaused)
        {
            <button class="btn btn-info" @onclick="ResumeRecording">▶️ Resume</button>
        }
        <button class="btn btn-danger" @onclick="StopRecording" disabled="@(IsRecording == false)">⏹️ Stop</button>

        <!-- Custom crop buttons (shown only when detectionType is "custom") -->
        @if (detectionType == "custom")
        {
            <button class="btn btn-secondary" @onclick="StartCustomCrop">✂️ Start Custom Crop</button>
            <button class="btn btn-success me-2" @onclick="LockCustomCropDetect">🔒 Detect on Live Feed</button>
            <button class="btn btn-primary me-2" @onclick="ConfirmCustomCrop">➡️ Crop to Next Page</button>
            <button class="btn btn-secondary" @onclick="CancelCustomCrop">✖️ Cancel Crop</button>
            
            <div class="mt-2 text-sm">
                <p>📍 Offset X: @OffsetX px</p>
                <p>📍 Offset Y: @OffsetY px</p>
                <p>🔄 Rotation: @Rotation°</p>
            </div>
        }
        else 
        {
            <button class="btn btn-secondary" @onclick="StartDetection">🟢 Start Detection</button>
            <button class="btn btn-secondary" @onclick="StopDetectionAsync">🔴 Stop Detection</button>
            <button class="btn btn-primary" @onclick="OnCheck">✅ Check</button>
        }
    </div>
</div>

@code {
    private List<CameraDevice> cameras = new();
    private string detectionType = "rect";
    private string? selectedCamera;
    private bool ShowNotice;
    private string NoticeMessage = "";
    private string NoticeCss = "";
    private bool IsRecording = false;
    private int RecordingSeconds = 0;
    private string RecordingTimeDisplay => TimeSpan.FromSeconds(RecordingSeconds).ToString(@"mm\:ss");
    private System.Timers.Timer? RecordingTimer;
    private bool IsPaused = false;

    private double OffsetX;
    private double OffsetY;
    private double Rotation;
    private double offsetX1;
    private double offsetY1;
    private double rotation1;
    private DetectionCallbackHelper? _cbHelper;
    private DotNetObjectReference<DetectionCallbackHelper>? _cbHelperRef;

    public class CameraDevice
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Settings.HasCamera)
        {
            selectedCamera = Settings.CameraId;

            await JS.InvokeVoidAsync("startCamera", Settings.CameraId);

            await JS.InvokeVoidAsync("eval", $@"
                import('/js/overlay-renderer.js').then(m => {{
                    window.overlay = m.OverlayRenderer;
                    window.overlay.init('videoElement', 'overlayCanvas');
                }});
                window.selectedCameraName = '{Settings.CameraLabel}';
            ");

            ShowNoticeBar($"📷 Camera started: {Settings.CameraLabel}", "info");
        }
    }

    private async Task OnCameraSelected(ChangeEventArgs e)
    {
        if (IsRecording)
        {
            ShowNoticeBar("⚠️ Cannot switch camera while recording!", "warning");
            return;
        }

        selectedCamera = e.Value?.ToString();
        if (!string.IsNullOrEmpty(selectedCamera))
        {
            var selectedCameraLabel = cameras.FirstOrDefault(c => c.Id == selectedCamera)?.Label ?? "UnknownCamera";

            // Start the camera in JS
            await JS.InvokeVoidAsync("startCamera", selectedCamera);

            // 🟢 Save the camera label globally in JS so takePhoto() & stopRecording() can use it
            await JS.InvokeVoidAsync("eval", $@"
                import('/js/overlay-renderer.js').then(m => {{
                    window.overlay = m.OverlayRenderer;
                    window.overlay.init('videoElement', 'overlayCanvas');
                }});
                window.selectedCameraName = '{selectedCameraLabel}';
            ");

            ShowNoticeBar($"📷 Camera started: {selectedCameraLabel}", "info");
        }
    }
    private async Task StartDetection()
    {
        if (_cbHelper == null)
        {
            _cbHelper = new DetectionCallbackHelper { Parent = this };
            _cbHelperRef = DotNetObjectReference.Create(_cbHelper);
        }

        await JS.InvokeVoidAsync("DetectionModules.startPipeline", "videoElement", _cbHelperRef, detectionType);
    }

    private async Task StopDetectionAsync()
    {
        try
        {
            // Call the JS stopPipeline function
            await JS.InvokeVoidAsync("DetectionModules.stopPipeline");
            ShowNoticeBar("🔴 Detection stopped", "warning");
        }
        catch (Exception ex)
        {
            ShowNoticeBar($"⚠ Failed to stop detection: {ex.Message}", "warning");
        }
    }

    private async Task TakePhoto()
    {
        var savedPath = await JS.InvokeAsync<string>("takePhoto");

        if (!string.IsNullOrEmpty(savedPath))
        {
            // 1️⃣ Store latest captured image
            MediaState.LatestCapturedPath = savedPath;

            // 2️⃣ Optional notice
            ShowNoticeBar("📸 Photo captured. Opening Media Library...", "success");

            // 3️⃣ Navigate to Media Library
            Nav.NavigateTo("/media-library");
        }
        else
        {
            ShowNoticeBar("❌ Photo save failed", "error");
        }
    }

    private async Task StartRecording()
    {
        IsRecording = true;
        IsPaused = false;
        RecordingSeconds = 0;
        StartTimer();
        await JS.InvokeVoidAsync("startRecording");
        ShowNoticeBar("⏺️ Recording started...", "warning");
    }

    private async Task PauseRecording()
    {
        if (!IsRecording || IsPaused)
            return;

        await JS.InvokeVoidAsync("pauseRecording");
        PauseTimer();
        IsPaused = true;
        ShowNoticeBar("⏸️ Recording paused.", "warning");
    }

    private async Task ResumeRecording()
    {
        if (!IsRecording || !IsPaused)
            return;

        await JS.InvokeVoidAsync("resumeRecording");
        ResumeTimer();
        IsPaused = false;
        ShowNoticeBar("▶️ Recording resumed.", "info");
    }

    private async Task StopRecording()
    {
        if (!IsRecording)
            return;

        StopTimer();
        IsRecording = false;
        IsPaused = false;

        var savedPath = await JS.InvokeAsync<string>("stopRecording");
        if (!string.IsNullOrEmpty(savedPath))
            ShowNoticeBar($"⏹️ Recording stopped and saved to: {savedPath}", "success");
        else
            ShowNoticeBar("❌ Recording save failed", "error");
    }


    [JSInvokable]
    public Task OnTargetOffsetsUpdated(double x, double y, double r)
    {
        offsetX1 = x;
        offsetY1 = y;
        rotation1 = r;

        Console.WriteLine($"📥 Received offsets from JS => X: {x}, Y: {y}, R: {r}");
        InvokeAsync(StateHasChanged);

        return Task.CompletedTask;
    }


    private async Task StartCustomCrop()
    {
        await JS.InvokeVoidAsync("eval", "if(window.mainPipeline){ window.mainPipeline.stop(); }");
        await JS.InvokeVoidAsync("DetectionModules.enableCustomCrop", "overlayCanvas");
        ShowNoticeBar("✂️ Custom crop mode enabled.", "info");
    }

    private async Task ConfirmCustomCrop()
    {
        try
        {
            var result = await JS.InvokeAsync<UploadResponse>("DetectionModules.uploadCustomCrop", 400, 300);

            if (result == null || !result.success)
            {
                ShowNoticeBar(result?.message ?? "Upload failed", "error");
                return;
            }

            Nav.NavigateTo($"/check-target?img={Uri.EscapeDataString(result.fileUrl)}");
        }
        catch (JSException jsEx)
        {
            ShowNoticeBar($"❌ JS exception: {jsEx.Message}", "error");
        }
    }

    public class UploadResponse
    {
        public bool success { get; set; }
        public string fileUrl { get; set; }
        public string message { get; set; }
        public int size { get; set; }
    }

    // For deserialization
    private class ImageUploadResult
    {
        public string FileUrl { get; set; } = "";
    }

    private async Task LockCustomCropDetect()
    {
        // Pass "this" component reference to JS
        await JS.InvokeVoidAsync("DetectionModules.lockCustomCropForDetection", DotNetObjectReference.Create(this));
    }

    private async Task StopCustomCropDetect()
    {
        await JS.InvokeVoidAsync("eval", "if(window._customCropLoop){ clearInterval(window._customCropLoop); window._customCropLoop = null; }");
        ShowNoticeBar("🛑 Stopped live focus.", "warning");
    }
    
    private async Task CancelCustomCrop()
    {
        await JS.InvokeVoidAsync("eval", "if(window._customCrop){ window._customCrop.disable(); }");    
        ShowNoticeBar("✖️ Custom crop mode disabled.", "info");
    }

    private async Task OnCheck()
    {
        try
        {
            // Ask JS for the currently selected target image
            var base64Image = await JS.InvokeAsync<string>("DetectionModules.getSelectedTargetImage");

            if (string.IsNullOrEmpty(base64Image))
            {
                ShowNoticeBar("❗ No target selected. Click a detected shape first.", "warning");
                return;
            }

            // Optional: stop detection to avoid conflicts
            await JS.InvokeVoidAsync("eval", "if(window.mainPipeline){ window.mainPipeline.stop(); }");

            // Navigate to CheckTarget page with image as query param (or use session/local storage if too large)
            Nav.NavigateTo($"/check-target?img={Uri.EscapeDataString(base64Image)}");
        }
        catch (JSException)
        {
            ShowNoticeBar("❌ Could not capture target image from JS.", "error");
        }
        catch (Exception ex)
        {
            ShowNoticeBar($"❌ Error: {ex.Message}", "error");
        }
    }

    private void StartTimer()
    {
        RecordingTimer = new System.Timers.Timer(1000);
        RecordingTimer.Elapsed += (s, e) =>
        {
            RecordingSeconds++;
            InvokeAsync(StateHasChanged);
        };
        RecordingTimer.Start();
    }

    private void StopTimer()
    {
        RecordingTimer?.Stop();
        RecordingTimer?.Dispose();
        RecordingTimer = null;
    }

    private void PauseTimer()
    {
        RecordingTimer?.Stop();
    }

    private void ResumeTimer()
    {
        RecordingTimer?.Start();
    }

    private void ShowNoticeBar(string message, string type)
    {
        NoticeMessage = message;
        NoticeCss = type switch
        {
            "success" => "notice-success",
            "warning" => "notice-warning",
            "error" => "notice-error",
            _ => "notice-info"
        };

        ShowNotice = true;
        StateHasChanged();

        _ = Task.Run(async () =>
        {
            await Task.Delay(5000);
            ShowNotice = false;
            await InvokeAsync(StateHasChanged);
        });
    }

    [JSInvokable]
    public void UpdateCropInfo(double offsetX, double offsetY, double rotation)
    {
        OffsetX = offsetX;
        OffsetY = offsetY;
        Rotation = rotation;

        // Force UI to refresh
        InvokeAsync(StateHasChanged);
    }

}
