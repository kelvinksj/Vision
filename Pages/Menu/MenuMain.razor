@page "/Menu/MenuMain"
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject CommonLib CommonLib
@inject IJSRuntime jsRuntime
@inject NavigationManager NavigationManager
@inject ScreenWakeLockService ScreenWakeLockService
@inject UserAccountService UserAccountService
@inject WorkerService WorkerService

<style>
    .content {
        display: flex;
        flex-wrap: wrap;
    @* gap: 10px; *@
    }

    .box {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 300px;
        height: 250px;
        background-color: white;
        color: white;
        position: relative;
        cursor: pointer;
        transition: background-color 0.3s ease;
        border: 2px solid black;
    }

    .box:hover {
        background-color: rgba(217, 217, 217, 1);
    }

    .box label {
        position: absolute;
        top: 0;
        margin: 0;
        background-color: rgba(110, 113, 115, 1);
        width: 100%;
        text-align: center;
        color: white;
        box-sizing: content-box;
        border-bottom: 2px solid black;
        font-size: 28px;
    }

    .setSVG {
        margin-top: 50px;
    }
</style>

<PageTitle>@CommonParameters.AppName</PageTitle>

<AuthorizeView Roles="Administrator,Engineer,Supervisor,Operator">
    <Authorized>
        <div class="outer">
            <div class="contain-size">
                <div class="box1">
                    <h1 id="MyHeader" class="header no-select">
                        Main Selection
                    </h1>
                </div>
                <div class="inner">
                    <div class="segmentColumn">
                        <div class="segmentRow" style="margin-bottom: 45px;">
                            @if (!isOperator && !isSupervisor)
                            {
                                <div class="box" style="margin-right: 45px;" @onclick="Navigate1">
                                    <label class="no-select">User & Maintenance</label>
                                    <div class="icon_risk_management_grey setSVG" />
                                </div>
                            }
                            else
                            {
                                <div class="box" style="margin-right: 45px;" @onclick="Navigate1">
                                    <label class="no-select">User</label>
                                    <div class="icon_risk_management_grey setSVG" />
                                </div>
                            }
                            @if (!isOperator)
                            {
                                <div class="box" style="margin-right: 45px;" @onclick="Navigate2">
                                    <label class="no-select">Layout</label>
                                    <div class="icon_program_grey setSVG" />
                                </div>
                                <div class="box" @onclick="Navigate3">
                                    <label class="no-select">Kit</label>
                                    <div class="icon_barcode_scanner_grey setSVG" />
                                </div>
                            }
                            else
                            {
                                if (accessPage == "CI")
                                {
                                    <div class="box" @onclick="Navigate6">
                                        <label class="no-select">Check In</label>
                                        <div class="icon_forklift_grey setSVG" />
                                    </div>
                                }
                                else if (accessPage == "CO")
                                {
                                    <div class="box" @onclick="Navigate6">
                                        <label class="no-select">Check Out</label>
                                        <div class="icon_sequence_grey setSVG" />
                                    </div>
                                }
                                else if (accessPage == "CPC")
                                {
                                    <div class="box" @onclick="Navigate6">
                                        <label class="no-select">Finished Good</label>
                                        <div class="icon_goods_grey setSVG" />
                                    </div>
                                }
                                else if (accessPage == "GL")
                                {
                                    <div class="box" @onclick="Navigate6">
                                        <label class="no-select">Gaylord</label>
                                        <div class="icon_recycle_grey setSVG" />
                                    </div>
                                }
                                else
                                {
                                    <div class="box" @onclick="Navigate6">
                                        <label class="no-select">Line @lineNo.ToString("00")</label>
                                        <div class="icon_assembly_line_grey setSVG" />
                                    </div>
                                }
                            }
                        </div>
                        @if (!isOperator)
                        {
                            <div class="segmentRow">
                                <div class="box" style="margin-right: 45px;" @onclick="Navigate4">
                                    <label class="no-select">Kit Layout</label>
                                    <div class="icon_link_grey setSVG" />
                                </div>
                                <div class="box" style="margin-right: 45px;" @onclick="Navigate5">
                                    <label class="no-select">Setup Line</label>
                                    <div class="icon_manufacturing_grey setSVG" />
                                </div>
                                <div class="box" @onclick="Navigate6">
                                    <label class="no-select">All Lines</label>
                                    <div class="icon_assembly_line_grey setSVG" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <span class="spinner-border spinner-border-lg align-center"></span>
        <span> Checking authorization in progress ...........</span>
    </NotAuthorized>
</AuthorizeView>