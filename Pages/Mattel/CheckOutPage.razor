@using TaskManagerWeb.Components.Pages.Common

@page "/Mattel/CheckOutPage"
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject CommonLib CommonLib
@inject ContainerService ContainerService
@inject HttpClient Http
@inject IJSRuntime jsRuntime
@inject MattelService MattelService
@inject NavigationManager NavigationManager
@inject PaginationService<MattelClass.Container> PaginationService
@inject SortingModel<MattelClass.Container> SortingModel
@inject TaskManagerService TaskManagerService

<style>
    .CheckOutPage-style {
        .input {
            margin-right: 20px;
            background-color: rgba(217, 217, 217, 1);
            border-color: black;
            border-radius: 0px;
            width: 230px;
        }

        .label {
            font-size: 120x;
            font-weight: bold;
            color: rgba(110, 113, 115, 1);
            margin-top: 10px;
        }

        .table-set {
            height: 390px;
        }

        .setSVG {
            position: absolute;
            right: 5px;
            top: 13px;
            width: 24px;
            height: 24px;
        }
    }
</style>

<PageTitle>@CommonParameters.AppName</PageTitle>

<AuthorizeView Roles="Administrator,Engineer,Supervisor,Operator">
    <Authorized>
        <div class="CheckOutPage-style outer" @onclick="() => OnMouseClick()">
            <div class="contain-size">
                <div class="box1">
                    <h1 id="MyHeader" class="header no-select">
                        Check Out
                    </h1>
                </div>
                <div class="box-wrapper">
                    <div class="box2">
                        <div class="segmentRow">
                            <div class="segmentColumn gapRight">
                                <div class="segmentColumn gapBottom">
                                    <label class="label no-select">Please enter a filter :</label>
                                    <div class="segmentRow">
                                        <input @bind="filter" type="text" class="form-control input" maxlength="15"
                                            autocomplete="off" />
                                        <button type="button" class="btn btn-sm common-btn gapRight"
                                            @onclick="() => OnClickFilter()">
                                            Query
                                        </button>
                                        <button type="button" class="btn btn-sm common-btn gapRight"
                                            disabled="@disableBtn" style="@disableColor"
                                            @onclick="() => OnClickCheckout()">
                                            Checkout
                                        </button>
                                        <button type="button" class="btn btn-sm common-btn"
                                            @onclick="() => OnClickMap()">
                                            Map
                                        </button>
                                    </div>
                                </div>
                                <div class="table-set">
                                    <table class="table scrolldown">
                                        <colgroup>
                                            <col style="width: 150px;">
                                            <col style="width: 150px;">
                                            <col style="width: 150px;">
                                            <col style="width: 150px;">
                                            <col style="width: 150px;">
                                        </colgroup>
                                        <thead>
                                            <tr>
                                                <th class="no-select">
                                                    <div class="segmentRow">
                                                        <div style="margin-left: 8px;">
                                                            Kit#
                                                        </div>
                                                        <div class="@(SortingModel.SortIcons["KitId"]) setSVG"
                                                            @onclick="@(async () => await SortItems("KitId"))" />
                                                    </div>
                                                </th>
                                                <th class="no-select">
                                                    <div class="segmentRow">
                                                        <div style="margin-left: 8px;">
                                                            Part#
                                                        </div>
                                                        <div class="@(SortingModel.SortIcons["SkuId"]) setSVG"
                                                            @onclick="@(async () => await SortItems("SkuId"))" />
                                                    </div>
                                                </th>
                                                <th class="no-select">
                                                    <div class="segmentRow">
                                                        <div style="margin-left: 8px;">
                                                            Table ID
                                                        </div>
                                                        <div class="@(SortingModel.SortIcons["ContainerId"]) setSVG"
                                                            @onclick="@(async () => await SortItems("ContainerId"))" />
                                                    </div>
                                                </th>
                                                <th class="no-select">
                                                    <div class="segmentRow">
                                                        <div style="margin-left: 8px;">
                                                            Status
                                                        </div>
                                                        <div class="@(SortingModel.SortIcons["Status"]) setSVG"
                                                            @onclick="@(async () => await SortItems("Status"))" />
                                                    </div>
                                                </th>
                                                <th class="no-select">
                                                    <div class="segmentRow">
                                                        <div style="margin-left: 8px;">
                                                            Check In
                                                        </div>
                                                        <div class="@(SortingModel.SortIcons["IndexDateTime"]) setSVG"
                                                            @onclick="@(async () => await SortItems("IndexDateTime"))" />
                                                    </div>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (PaginationService.GetItems().Any())
                                            {
                                                foreach (var item in PaginationService.GetItems())
                                                {
                                                    <tr class="@GetRow(item)" @onclick="() => SelectRow(item)">
                                                        <td>
                                                            <div class="no-select">
                                                                @item.KitId
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <div class="no-select">
                                                                @item.SkuId
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <div class="no-select" style="text-align: center;">
                                                                @item.ContainerId
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <div class="no-select" style="text-align: center;">
                                                                @item.Status
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <div class="no-select" style="text-align: center;">
                                                                @item.IndexDateTime
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="5" class="text-center no-select">
                                                        <div>No data</div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <Pagination T="MattelClass.Container" PaginationService="PaginationService"
                                    OnPageChanged="OnPageChanged" />
                            </div>
                            <div style="margin-bottom: 10px;">
                                <MsgList MList="@mList" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <PopMsg PopMsgData="@popMsgData" />
    </Authorized>
    <NotAuthorized>
        <span class="spinner-border spinner-border-lg align-center" />
        <span> Checking authorization in progress ...........</span>
    </NotAuthorized>
</AuthorizeView>