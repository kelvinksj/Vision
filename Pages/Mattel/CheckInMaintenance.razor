@using TaskManagerWeb.Components.Pages.Common

@page "/Mattel/CheckInMaintenance"
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject CommonLib CommonLib
@inject ContainerService ContainerService
@inject IJSRuntime jsRuntime
@inject MattelService MattelService
@inject NavigationManager NavigationManager
@inject PaginationService<MattelClass.LayoutData> PaginationService
@inject TaskManagerService TaskManagerService

<style>
    .checkInMaintenance-style {
        .custom-select-wrapper {
            position: relative;
            display: inline-block;

            .custom-select {
                width: 180px;
                outline: none !important;
            }

            .custom-select-arrow {
                position: absolute;
                left: 150px;
                top: 6px;
                pointer-events: none;
            }
        }

        .icon-box {
            position: absolute;
            top: 0px;
            right: 0px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
        }

        .setSVG {
            height: 30px;
            width: 30px;
        }

        .dropdown-list {
            position: absolute;
            background-color: white;
            border: 1px solid #ccc;
            width: 100%;
            max-height: 150px;
            overflow-y: auto;
            z-index: 1000;
            border-radius: 8px;
            line-height: 0.8em;
        }

        .dropdown-item {
            padding: 8px;
            cursor: pointer;
        }

        .dropdown-item:hover {
            background-color: #1967d2;
            color: #ffffff;
        }
    }
</style>

<PageTitle>@CommonParameters.AppName</PageTitle>

<AuthorizeView Roles="Administrator,Engineer">
    <Authorized>
        <div class="checkInMaintenance-style outer">
            <div class="contain-size">
                <div class="box1">
                    <h1 id="MyHeader" class="header no-select">
                        Check In Table
                    </h1>
                </div>
                <div class="box-wrapper">
                    <div class="box2">
                        <div class="segmentRow">
                            <div class="segmentColumn gapRight">
                                @if (checkInList != null)
                                {
                                    <div class="gapBottom">
                                        <RenderFragmentComponent Content="dynamicComponent!" />
                                    </div>
                                }
                                <EditForm Model="@selectedSheet" OnValidSubmit="() => OnValidSubmit()"
                                    autocomplete="off" Context="editContext">
                                    <DataAnnotationsValidator />
                                    <div class="box-wrapper">
                                        <div class="box2">
                                            <div class="segmentColumn" style="margin-top: 100px;">
                                                <div class="segmentRow">
                                                    <label class="no-select" style="font-size: 20px; padding-top: 5px;">
                                                        Type
                                                    </label>
                                                    <div style="margin-left: 10px;" />
                                                    <div class="custom-select-wrapper">
                                                        <InputText class="form-control custom-select" maxlength="15"
                                                            @bind-Value="selectedType"
                                                            @onclick="() => ToggleTypeDropdown()" />
                                                        <div class="dropdown-list"
                                                            style="@(showTypeDropdown ? "display:block;" : "display:none;")">
                                                            @foreach (var item in containerTypes)
                                                            {
                                                                <div class="dropdown-item"
                                                                    @onclick="() => SelectTypeNumber(item)">
                                                                    @item
                                                                </div>
                                                            }
                                                        </div>
                                                        <div class="icon-box" @onclick="() => ToggleTypeDropdown()">
                                                            <div class="icon_selection_down setSVG" />
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="segmentRow gapTop">
                                                    <label class="no-select"
                                                        style="font-size: 20px; padding-left: 17px; padding-top: 5px;">
                                                        Kit
                                                    </label>
                                                    <div style="margin-left: 10px;" />
                                                    <div class="custom-select-wrapper">
                                                        <input type="text" disabled="@DisableSelectKit" maxlength="15"
                                                            class="form-control custom-select" style="@selectFontColor1"
                                                            @bind-value="selectedSheet.KitNumber"
                                                            @bind-value:after="() => HandleKitChange(selectedSheet.KitNumber)"
                                                            @oninput="(e) => FilterKit(e!.Value!.ToString()!)"
                                                            @onclick="() => ToggleKitDropdown()" />
                                                        <div class="dropdown-list"
                                                            style="@(showKitDropdown ? "display:block;" : "display:none;")">
                                                            @foreach (var item in filteredKits)
                                                            {
                                                                <div class="dropdown-item"
                                                                    @onclick="() => SelectKitNumber(item)">
                                                                    @item.KitNumber
                                                                </div>
                                                            }
                                                        </div>
                                                        <div class="icon-box" @onclick="() => ToggleKitDropdown()">
                                                            <div class="icon_selection_down setSVG" />
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="segmentRow gapTop">
                                                    <label class="no-select"
                                                        style="font-size: 20px; padding-left: 5px; padding-top: 5px;">
                                                        Part
                                                    </label>
                                                    <div style="margin-left: 10px;" />
                                                    <div class="custom-select-wrapper">
                                                        <input type="text" disabled="@DisableSelectPart" maxlength="15"
                                                            class="form-control custom-select" style="@selectFontColor2"
                                                            @bind-value="selectedPart"
                                                            @bind-value:after="() => HandlePartChange(selectedPart)"
                                                            @oninput="(e) => FilterPart(e!.Value!.ToString()!)"
                                                            @onclick="() => TogglePartDropdown()" />
                                                        <div class="dropdown-list"
                                                            style="@(showPartDropdown ? "display:block;" : "display:none;")">
                                                            @foreach (var item in filteredParts)
                                                            {
                                                                <div class="dropdown-item"
                                                                    @onclick="() => SelectPartNumber(item)">
                                                                    @item
                                                                </div>
                                                            }
                                                        </div>
                                                        <div class="icon-box" @onclick="() => TogglePartDropdown()">
                                                            <div class="icon_selection_down setSVG" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </EditForm>
                            </div>
                            <div class="segmentColumn">
                                <div style="margin-bottom: 10px;">
                                    <MsgList MList="@mList" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <PopMsg PopMsgData="@popMsgData" />
        <PopContainer PopContainerData="@popContainerData" />
    </Authorized>
    <NotAuthorized>
        <span class="spinner-border spinner-border-lg align-center" />
        <span> Checking authorization in progress ...........</span>
    </NotAuthorized>
</AuthorizeView>