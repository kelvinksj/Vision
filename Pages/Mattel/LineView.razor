@using TaskManagerWeb.Components.Pages.Common

@page "/Mattel/LineView"
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject CommonLib CommonLib
@inject HttpClient Http
@inject IJSRuntime jsRuntime
@inject MattelService MattelService
@inject NavigationManager NavigationManager

<style>
    .lineview-style {
        .pop-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1000;

            .pop-content {
                position: relative;
                height: 600px;
                width: 600px;
                box-sizing: border-box;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                background: white;
            }
        }

        .for-print {
            display: none;
        }
    }

    .map-style {
        width: 525px;
        height: 450px;
        transform-origin: top left;
        transform: scale(0.8);
    }
</style>

<AuthorizeView Roles="Administrator,Engineer,Supervisor">
    <Authorized>
        <div class="lineview-style">
            <div class="pop-overlay" style="@(true ? "display: flex;" : "display: none;")">
                <div class="pop-content">
                    <div class="segmentColumn">
                        <div id="PrintThis">
                            <div>
                                <h1 id="MyHeader" class="header no-select">
                                    @orderKit.KitNumber (@orderKit.LayoutName)
                                    @{
                                        imageSrc = GetBarcodeImage($"@K{orderKit.KitNumber}");

                                        if (imageSrc != string.Empty)
                                        {
                                            <img class="for-print" src="@imageSrc" alt="Barcode" />
                                        }
                                    }
                                </h1>
                            </div>
                            <div class="map-style">
                                @if (ParentVariable1 != null)
                                {
                                    <RenderFragmentComponent Content="dynamicComponent!" />
                                }
                            </div>
                            <div class="for-print">
                                <div class="table-set">
                                    <table class="table scrolldown">
                                        <colgroup>
                                            <col style="width: 300px;">
                                            <col style="width: 300px;">
                                        </colgroup>
                                        @* <thead>
                                            <tr>
                                                <th>
                                                    <div>
                                                        Part Number
                                                    </div>
                                                </th>
                                                <th>
                                                    <div>
                                                        Description
                                                    </div>
                                                </th>
                                            </tr>
                                        </thead> *@
                                        <tbody>
                                            @if (partnumbers != null)
                                            {
                                                int rowCount = 0;
                                                int maxRow = 5;
                                                for (int i = 0; i < partnumbers.Count; i += 2)
                                                {
                                                    <tr style="height: 100px;">
                                                        <td>
                                                            @if (i < partnumbers.Count)
                                                            {
                                                                <div class="segmentColumn" style="align-items: start;">
                                                                    @{
                                                                        imageSrc = GetBarcodeImage($"@P{partnumbers[i].PartNumber}");

                                                                        if (imageSrc != string.Empty)
                                                                        {
                                                                            <div style="margin: 0px 0px 10px;">
                                                                                <img src="@imageSrc" alt="Barcode" />
                                                                            </div>
                                                                        }
                                                                    }
                                                                    <div class="no-select">@partnumbers[i].PartNumber</div>
                                                                    <div class="no-select">@partnumbers[i].Description</div>
                                                                </div>
                                                            }
                                                        </td>
                                                        <td>
                                                            @{
                                                                int z = i + 1;

                                                                if (z < partnumbers.Count)
                                                                {
                                                                    <div class="segmentColumn" style="align-items: end;">
                                                                        @{
                                                                            imageSrc = GetBarcodeImage($"@P{partnumbers[z].PartNumber}");

                                                                            if (imageSrc != string.Empty)
                                                                            {
                                                                                <div style="margin: 0px 0px 10px;">
                                                                                    <img src="@imageSrc" alt="Barcode" />
                                                                                </div>
                                                                            }
                                                                        }
                                                                        <div class="no-select">@partnumbers[z].PartNumber</div>
                                                                        <div class="no-select">@partnumbers[z].Description</div>
                                                                    </div>
                                                                }
                                                            }
                                                        </td>
                                                        @{
                                                            rowCount++;
                                                        }
                                                    </tr>
                                                    if (rowCount >= maxRow && i < partnumbers.Count)
                                                    {
                                                        rowCount = 0;
                                                        maxRow = 9;
                                                        <tr class="page-break-after"></tr>
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="3" class="text-center">
                                                        <div>No data</div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="btn-wrapper">
                            <div class="segmentRow">
                                <button type="button" class="btn btn-sm common-btn gapRight" @onclick="() => OnClickPrint()">
                                    Print
                                </button>
                                <button type="button" class="btn btn-sm common-btn" @onclick="() => OnClickOK()">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <span class="spinner-border spinner-border-lg align-center" />
        <span> Checking authorization in progress ...........</span>
    </NotAuthorized>
</AuthorizeView>