@using TaskManagerWeb.Components.Pages.Common

@page "/Mattel/CheckInPage"
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject CommonLib CommonLib
@inject ContainerService ContainerService
@inject IJSRuntime jsRuntime
@inject MattelService MattelService
@inject NavigationManager NavigationManager
@inject PaginationService<MattelClass.LayoutData> PaginationService
@inject TaskManagerService TaskManagerService

<style>
    .icon_cancel_orange {
        height: 50px;
        width: 50px;
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
        cursor: pointer;
    }

    .table-set {
        height: 364px;
    }

    .icon-box-wrapper {
        height: auto;
        width: auto;
        display: flex;
        flex-direction: column;
        flex-wrap: wrap;
        justify-content: center;
        align-content: center;
    }

    .icon_ProGlove_BLE_HID {
        height: 60px;
        width: 60px;
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
    }

    .msglist {
        --msg-height: 520px !important;
    }
</style>

<PageTitle>@CommonParameters.AppName</PageTitle>

<AuthorizeView Roles="Administrator,Engineer,Supervisor,Operator">
    <Authorized>
        <div class="outer" @onmousedown="() => HandleOnMouseDown()">
            <div class="contain-size">
                <div class="box1">
                    <h1 id="MyHeader" class="header no-select">
                        Check In
                    </h1>
                </div>
                <div class="box-wrapper">
                    <div class="box2">
                        <div class="segmentRow">
                            <div class="segmentColumn gapRight">
                                @if (checkInList != null)
                                {
                                    <div class="gapBottom">
                                        <RenderFragmentComponent Content="dynamicComponent!" />
                                    </div>
                                }
                                <div class="segmentRow" style="margin-top: 10px;">
                                    @for (int i = 7; i >= 1; i--)
                                    {
                                        var Location = i;

                                        <button type="button" class="btn btn-sm common-btn"
                                            style="width: 76px; @disableStyleManualLocation"
                                            disabled="@disableManualLocation"
                                            @onclick="() => OnClickManualLocation(Location)">
                                            L<a>@i</a>
                                        </button>

                                        if (i > 1 && i <= 7)
                                        {
                                            <div style="margin-left: 7px;" />
                                        }
                                    }
                                </div>
                                <div class="table-set" style="margin-top: 10px;">
                                    <table class="table scrolldown">
                                        <colgroup>
                                            <col style="width: 160px;">
                                            <col style="width: 210px;">
                                            <col style="width: 200px;">
                                        </colgroup>
                                        <thead>
                                            <tr>
                                                <th class="no-select">
                                                    <div class="segmentRow">
                                                        <div style="margin-left: 8px;">
                                                            Kit
                                                        </div>
                                                    </div>
                                                </th>
                                                <th class="no-select">
                                                    <div class="segmentRow">
                                                        <div style="margin-left: 8px;">
                                                            Part Number
                                                        </div>
                                                    </div>
                                                </th>
                                                <th class="no-select">
                                                    <div class="header-wrapper segmentRow">
                                                        <div style="">
                                                            Location
                                                        </div>
                                                    </div>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (checkInList != null && checkInList.List.Count > 0)
                                            {
                                                @foreach (var item in checkInList.List)
                                                {
                                                    <tr class="@GetRow(item)" style="@GetUserRow(item)"
                                                        @onclick="() => SelectRow(item)">
                                                        <td>
                                                            <div class="no-select" style="@GetUserRow2(item)">
                                                                @item.KitNumber
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <div class="no-select" style="@GetUserRow2(item)">
                                                                @item.PartNumber
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <div class="no-select"
                                                                style="@GetUserRow2(item) text-align: center;">
                                                                @item.Point
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="3" class="text-center no-select">
                                                        <div>No data</div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <div class="segmentRow" style="margin-top: 10px;">
                                    <div class="box-wrapper">
                                        <div class="box2">
                                            <div class="segmentRow">
                                                <button type="button" class="btn btn-sm common-btn"
                                                    @onclick="() => OnClickCommit()">
                                                    Commit All
                                                </button>
                                                <button type="button" class="btn btn-sm common-btn gapLeft"
                                                    style="@disableStyleCancel" disabled="@disableCancel"
                                                    @onclick="() => OnClickCancel()">
                                                    Cancel
                                                </button>
                                                <button type="button" class="btn btn-sm common-btn gapLeft"
                                                    style="@disableStyleCancelAll" disabled="@disableCancelAll"
                                                    @onclick="() => OnClickCancelAll()">
                                                    Cancel All
                                                </button>
                                                <button type="button" class="btn btn-sm common-btn gapLeft"
                                                    @onclick="() => OnClickManual()">
                                                    Manual
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="segmentColumn">
                                <div style="margin-bottom: 10px;">
                                    <MsgList MList="@mList" />
                                </div>
                                <div class="segmentRow">
                                    <div class="icon-box-wrapper gapRight">
                                        <div class="icon_ProGlove_BLE_HID" />
                                    </div>
                                    <div class="no-select" style="width: 170px; color: red;">
                                        Please scan the barcode on the left for ProGlove to connect
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @if (showModal)
        {
            <div class="modal-overlay" style="@(showModal ? "display: flex;" : "display: none;")">
                <div class="modal-content">
                    <div class="modal-header">
                        Check-In Manually
                    </div>
                    @if (modalContent == "CheckInManual")
                    {
                        <CheckInManual ShowModalChanged="ShowModalChanged" OnCheckIn="OnCheckIn"
                            DropdownOptions="dropdownOptions" />
                    }
                </div>
            </div>
        }
        <PopMsg PopMsgData="@popMsgData" />
        <PopContainer PopContainerData="@popContainerData" />
    </Authorized>
    <NotAuthorized>
        <span class="spinner-border spinner-border-lg align-center" />
        <span> Checking authorization in progress ...........</span>
    </NotAuthorized>
</AuthorizeView>