<style>
    .standard-style {
        position: relative;
        height: 450px;

        .dotted-line-container {
            position: relative;
            height: 90px;
            width: 80px;
        }

        .dotted-line-container::before {
            content: '';
            position: absolute;
            left: 4px;
            border-left: 2px dotted red;
            height: 100%;
        }

        .resizable-dot {
            width: 10px;
            height: 10px;
            background-color: red;
            border-radius: 50%;
        }

        .conveyor {
            height: 40px;
            width: 590px;
            border: 1px solid black;
            background-color: green;
        }

        .text-center {
            height: 100%;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
        }

        .box-command {
            --command-height: 10px;
            --command-width: 60px;
            height: var(--command-height);
            width: var(--command-width);
            border: 1px solid black;
            box-sizing: border-box;
            cursor: default;
            background-color: white;
        }

        .box-outer {
            --outer-height: 60px;
            --outer-width: 60px;
            --title-height: 0.6;
            height: var(--outer-height);
            width: var(--outer-width);
            border: 1px solid black;
            box-sizing: border-box;
            cursor: default;

            .box-top {
                height: calc((var(--outer-height) * var(--title-height)) - 1px);
                width: 100%;
                background-color: #d3d3d3;
            }

            .box-text {
                height: calc((var(--outer-height) * (1 - var(--title-height))) - 1px);
                width: 100%;
                background-color: white;
            }
        }

        .custom-wrap {
            width: 60px;
            word-break: break-all;
            overflow-wrap: break-word;
        }

        .box-table {
            --table-height: 30px;
            --table-width: 60px;
            height: var(--table-height);
            width: var(--table-width);
            border: 1px solid black;
            box-sizing: border-box;
            background-color: #d3d3d3;
        }
    }

    .table-set {
        width: auto;
        height: auto;
        overflow-y: auto;
        overflow-x: auto;
        position: relative;
        display: block;

        table {
            display: block;
            width: auto;
            table-layout: auto;

            thead {
                div {
                    color: white;
                }

                tr {
                    border-collapse: collapse;
                    border-style: solid;
                    border-color: black;
                    border-width: 0px;
                }
            }

            tbody {
                div {
                    color: black;
                }

                tr {
                    border-collapse: collapse;
                    border-style: solid;
                    border-color: black;
                    border-width: 0px;
                }

                td:nth-of-type(1) {
                    text-align: left;
                }

                tr:nth-of-type(even) {
                    background-color: white;
                }

                tr:nth-of-type(odd) {
                    background-color: white;
                }
            }

            th,
            td {
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                border-spacing: 0;
            }

            th {
                border-collapse: collapse;
                border-style: solid;
                border-color: black;
                border-width: 2px;
                border-bottom-width: 0px;

                position: sticky;
                top: -1px;
                z-index: 1;
                line-height: 50px;
                text-align: center;
                background-color: #f36d33;
                padding: 0px;
            }

            td {
                border-collapse: collapse;
                border-style: solid;
                border-color: black;
                border-width: 2px;

                height: auto;
                text-align: left;
            }

            tr:hover td,
            tr:hover div {
                background-color: white;
                color: black;
                cursor: pointer;
            }

            tr.row-active td,
            tr.row-active div {
                background-color: #d9d9d9;
                color: #6e7173;
                cursor: pointer;
            }
        }
    }

    @@media print {
        .for-print {
            display: inline;
        }

        .map-style {
            width: auto;
            height: auto;
        }

        .page-break-before {
            display: block;
            break-before: page;
        }

        .page-break-after {
            display: block;
            break-after: page;
        }

        .page-break-inside {
            display: block;
            break-inside: avoid;
        }

        body {
            width: auto;
            height: auto;
            margin-left: 30px;
        }
    }
</style>

