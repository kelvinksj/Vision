@page "/Mattel/CheckInManual"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject WorkerService WorkerService
@inject ScreenWakeLockService ScreenWakeLockService
@inject CommonLib CommonLib
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime jsRuntime
@inject MattelService MattelService

<style>
    .input-style {
        width: 250px;
    }

    .modal-content {
        width: 400px;
    }

    .custom-select-wrapper {
        position: relative;
        display: inline-block;
        width: 250px;

        .custom-select-arrow {
            position: absolute;
            right: 7px;
            top: 7px;
            pointer-events: none;
        }
    }
</style>

<PageTitle>@CommonParameters.AppName</PageTitle>

<div class="box2">
    <div class="segmentColumn">
        <EditForm Model="@checkInData" OnValidSubmit="Confirm" autocomplete="off" Context="editContext">
            <DataAnnotationsValidator />
            <div class="segmentColumn gapBottom">
                <label class="no-select">Kit</label>
                <InputText @bind-Value="checkInData.KitNumber" @oninput="CheckInputKit" class="form-control input-style"
                    maxlength="15" autocomplete="off" />
            </div>
            <div class="segmentColumn gapBottom">
                <label class="no-select">Part Number</label>
                <InputText @bind-Value="checkInData.PartNumber" @oninput="CheckInputPart"
                    class="form-control input-style" maxlength="15" autocomplete="off" />
            </div>
            <div class="segmentColumn gapBottom">
                <label class="no-select">Location</label>
                <div class="custom-select-wrapper">
                    @* <InputSelect @bind-Value="model" @oninput="CheckInputLoc" class="form-control custom-select"
                        placeholder="Location" autocomplete="off">
                        @if (Models != null)
                        {
                            foreach (var item in Models)
                            {
                                <option value="@item">@item</option>
                            }
                        }
                    </InputSelect> *@

                    <InputSelect @bind-Value="selectedPoint" @oninput="CheckInputLoc" class="form-control custom-select"
                        placeholder="Location" autocomplete="off">
                        @if (DropdownOptions != null)
                        {
                            @foreach (var item in DropdownOptions)
                            {
                                <option value="@item">@item</option>
                            }
                        }
                    </InputSelect>
                    <svg class="custom-select-arrow" width="24" height="24" viewBox="0 0 24 24" fill="none"
                        xmlns="http://www.w3.org/2000/svg">
                        <path d="M7 10l5 5 5-5" stroke="#000" stroke-width="2" stroke-linecap="round"
                            stroke-linejoin="round" />
                    </svg>
                </div>
            </div>
            <div class="segmentRow gapBottom">
                <button type="button" @onclick="Confirm" class="btn btn-sm common-btn gapRight"
                    disabled="@IsCheckInDisabled" style="@disableColor">
                    Confirm
                </button>
                <button type="button" @onclick="CloseModal" class="btn btn-sm common-btn">Cancel</button>
            </div>
        </EditForm>
    </div>
</div>