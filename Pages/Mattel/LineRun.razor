@using TaskManagerWeb.Components.Pages.Common

@page "/Mattel/LineRun"
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject CommonLib CommonLib
@inject ContainerService ContainerService
@inject HttpClient Http
@inject IJSRuntime jsRuntime
@inject MattelService MattelService
@inject NavigationManager NavigationManager
@inject TaskManagerService TaskManagerService

<style>
    .btn-Commit,
    .btn-Cancel,
    .btn-CancelAll {
        background-color: #f36d33;
        border-color: #f36d33;
        border-radius: 30px;
        color: white;
        width: 120px;
        height: 40px;
        font-size: 20px;
        margin-right: 10px;
    }

    .btn-Commit:hover,
    .bbtn-Cancel:hover,
    .btn-CancelAll:hover {
        background-color: white;
        color: black;
    }

    .icon-box-wrapper {
        height: auto;
        width: auto;
        display: flex;
        flex-direction: column;
        flex-wrap: wrap;
        justify-content: center;
        align-content: center;
    }

    .custom-select-wrapper {
        position: relative;
        display: inline-block;

        .custom-select {
            width: 130px;
            outline: none !important;
        }

        .custom-select-arrow {
            position: absolute;
            left: 100px;
            top: 6px;
            pointer-events: none;
        }
    }

    .dotted-line-container {
        position: relative;
        height: 50px;
        width: 80px;
    }

    .dotted-line-container::before {
        content: '';
        position: absolute;
        left: 4px;
        border-left: 3px dotted red;
        height: 100%;
    }

    .resizable-dot {
        width: 10px;
        height: 10px;
        background-color: red;
        border-radius: 50%;
    }

    .conveyor {
        height: 40px;
        width: 590px;
        border: 1px solid black;
        background-color: green;
    }

    .text-center {
        height: 100%;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }

    .box-outer {
        --outer-height: 60px;
        --outer-width: 60px;
        --title-height: 0.6;
        height: var(--outer-height);
        width: var(--outer-width);
        border: 1px solid black;
        box-sizing: border-box;

        .box-top {
            height: calc((var(--outer-height) * var(--title-height)) - 1px);
            width: 100%;
            background-color: #d3d3d3;
        }

        .box-text {
            height: calc((var(--outer-height) * (1 - var(--title-height))) - 1px);
            width: 100%;
            background-color: white;
        }
    }

    .gapRight {
        margin-right: 10px;
    }
</style>

<PageTitle>@CommonParameters.AppName</PageTitle>

<AuthorizeView Roles="Administrator,Engineer,Supervisor,Operator">
    <Authorized>
        <div class="outer">
            <div class="contain-size">
                <div class="box1">
                    <h1 id="MyHeader" class="header no-select">
                        Line :
                    </h1>
                </div>
                <div class="box-wrapper">
                    <div class="box2">
                        <EditForm Model="@productionData" OnValidSubmit="() => OnValidSubmit()" autocomplete="off"
                            Context="editContext">
                            <DataAnnotationsValidator />
                            <div class="segmentRow gapBottom">
                                <div class="segmentColumn gapRight">
                                    <label class="no-select">Line Name</label>
                                    <div class="custom-select-wrapper">
                                        <InputSelect class="form-control custom-select" style="@selectFontColor"
                                            draggable="false" @bind-Value="productionData.LineName"
                                            disabled="@isOperator"
                                            @bind-Value:after="() => HandleOnChange(productionData.LineName)">
                                            @{
                                                if (productionData.LineName == null || productionData.LineName ==
                                                string.Empty)
                                                {
                                                    selectFontColor = "color: rgba(0, 0, 0, 0.6)";
                                                }
                                                else
                                                {
                                                    selectFontColor = "color: rgba(0, 0, 0, 1)";
                                                }
                                                <option class="no-select" value="" disabled selected hidden>
                                                    Line Name
                                                </option>
                                                foreach (var item in productionList.ProductionData)
                                                {
                                                    <option class="no-select" value="@item.LineName"
                                                        style="color: rgba(0, 0, 0, 1)">
                                                        @item.LineName
                                                    </option>
                                                }
                                            }
                                            using TaskManagerWeb.Components.Service.DR;
                                        </InputSelect>
                                        <svg class="custom-select-arrow" width="24" height="24" viewBox="0 0 24 24"
                                            fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M7 10l5 5 5-5" stroke="#000" stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                    </div>
                                </div>
                                <div class="segmentColumn gapRight no-select">
                                    <label class="no-select">Kit Layout</label>
                                    <InputText @bind-Value="productionData.OrderKitNumber"
                                        class="form-control no-select" style="width: 140px;" placeholder="Kit Layout"
                                        draggable="false" autocomplete="off" />
                                    @* <ValidationMessage For="() => user.UserName" /> *@
                                </div>
                                <div class="segmentColumn gapRight no-select">
                                    <label class="no-select">Status</label>
                                    <InputText @bind-Value="productionData.Status" class="form-control no-select"
                                        style="width: 140px;" placeholder="Status" draggable="false"
                                        autocomplete="off" />
                                    @* <ValidationMessage For="() => user.UserName" /> *@
                                </div>
                                <div class="segmentRow" style="margin-top: 23px;">
                                    <div style="gapRight">
                                        <button type="button" class="btn btn-sm btn-Commit" style="@disableStyleStart"
                                            disabled="@disableStart" @onclick="() => OnClickStart()">
                                            Start
                                        </button>
                                    </div>
                                    <div>
                                        <button type="button" class="btn btn-sm btn-Commit" style="@disableStyleEndProd"
                                            disabled="@disableEndProd" @onclick="() => OnClickEndProd()">
                                            End Prod
                                        </button>
                                    </div>
                                </div>
                                <div>
                                    <MsgList MList="@mList" />
                                </div>
                            </div>
                            @if (layoutData != null)
                            {
                                <div style="position: absolute; top: 100px;">
                                    <RenderFragmentComponent Content="dynamicComponent!" />
                                </div>
                            }
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
        <PopLine PopLineData="@popLineData" />
        <PopEndProd PopEndProdData="@popEndPRodData" />
    </Authorized>
    <NotAuthorized>
        <span class="spinner-border spinner-border-lg align-center" />
        <span> Checking authorization in progress ...........</span>
    </NotAuthorized>
</AuthorizeView>
