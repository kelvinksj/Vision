@using TaskManagerWeb.Components.Pages.Common

@page "/Mattel/Scan/Manage/{ID:int}"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject WorkerService WorkerService
@inject ScreenWakeLockService ScreenWakeLockService
@inject CommonLib CommonLib
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime jsRuntime
@inject MattelService MattelService
@inject PaginationService<MattelClass.SheetData> PartPaginationService
@inject PaginationService<MattelClass.SheetData> RawPaginationService
@inject PaginationService<MattelClass.Sheet> KitPaginationService
@inject SortingModel<MattelClass.SheetData> RawSortingModel
@inject SortingModel<MattelClass.SheetData> PartSortingModel

<style>
    .input {
        margin-right: 20px;
        background-color: rgba(217, 217, 217, 1);
        border-color: black;
        border-radius: 0px;
        width: 230px;
        margin-bottom: 20px;
    }

    .label {
        font-size: 20px;
        font-weight: bold;
        color: rgba(110, 113, 115, 1);
        margin-top: 10px;
    }

    .button {
        width: 100%;
        display: flex;
        justify-content: center;
        margin: 10px;
    }

    .button-scan {
        background-color: rgba(253, 148, 72, 1);
        border-color: rgba(253, 148, 72, 1);
        border-radius: 30px;
        color: white;
        font-weight: bold;
        font-size: 20px;
        width: 130px;
        height: 50px;
        margin-right: 10px;
        margin-bottom: 20px;
    }

    .button-add-kit,
    .button-edit-kit,
    .button-add-part,
    .button-edit-part,
    .button-rmv-part,
    .button-reset,
    .button-save,
    .button-cancel {
        background-color: rgba(243, 109, 51, 1);
        border-color: rgba(243, 109, 51, 1);
        border-radius: 30px;
        color: white;
        font-weight: bold;
        font-size: 20px;
        width: 130px;
        height: 50px;
        margin-right: 10px;
        margin-bottom: 20px;
    }

    .button-add-part,
    .button-edit-part,
    .button-rmv-part,
    .button-reset,
    .button-save,
    .button-cancel {
        margin-left: 20px;
        margin-bottom: 10px;
    }

    .button-scan:hover,
    .button-add-kit:hover,
    .button-edit-kit:hover,
    .button-add-part:hover,
    .button-edit-part:hover,
    .button-rmv-part:hover,
    .button-reset:hover,
    .button-save:hover,
    .button-cancel:hover {
        background-color: white;
        color: black;
    }

    .icon_filter {
        display: inline-block;
        width: 20px;
        height: 20px;
        position: absolute;
        right: 0;
        bottom: 15px;
        margin-right: 5px;
        background-size: cover;
        cursor: pointer;
    }

    .modal-active .top-row,
    .faded-button {
        pointer-events: none;
        opacity: 0.5;
    }

    .active-button {
        opacity: 1;
        pointer-events: auto;
    }

    .icon_save {
        height: 150px;
        width: 150px;
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
    }

    .table-set {
        height: 390px;

        table {
            th {
                text-align: left;
                padding-left: 10px;
            }
        }
    }

    .gapTop {
        margin-top: 50px;
    }

    .button-enabled {
        background-color: #f36d33;
        border-color: #f36d33;
        color: white;
        cursor: pointer;
    }

    .button-disabled {
        background-color: #a5a8a9;
        border-color: #a5a8a9;
        color: white;
        cursor: not-allowed;
    }

    .setSVG {
        position: absolute;
        right: 5px;
        top: 13px;
        width: 24px;
        height: 24px;
    }

    .segmentColumn2 {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    @* width: 350px; *@
    }

    .Paging {
        height: 60px;
    }
</style>

<PageTitle>@CommonParameters.AppName</PageTitle>

<AuthorizeView Roles="Administrator,Engineer,Supervisor">
    <Authorized>
        <div class="outer">
            <div class="contain-size">
                <div class="box1">
                    <h1 class="header no-select">
                        Setup Kit - Scan All Manage
                    </h1>
                </div>
                <div class="box-wrapper">
                    <div class="box2">
                        <div>
                            <div class="segmentColumn">
                                <div class="segmentRow">
                                    <label class="label">Please edit the Kit # if needed :</label>
                                </div>
                                <div class="segmentRow">
                                    <input class="form-control input" maxlength="15" autocomplete="off"
                                        @bind="selectedKitNumber" disabled />
                                    <button type="button" @onclick="EditKit" class="btn button-edit-kit"
                                        style="@EditKitBtnStyle">
                                        Edit Kit
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="segmentcolumn">
                            <div class="segmentRow">
                                <div class="segmentColumn2">
                                    <div class="table-set gapRight gapLeft">
                                        <table class="table scrolldown">
                                            <colgroup>
                                                <col style="width: 220px;">
                                                <col style="width: 220px;">
                                            </colgroup>
                                            <thead>
                                                <tr>
                                                    <th>
                                                        <div class="segmentRow">
                                                            <div style="margin-left: 8px;">Part #</div>
                                                            <div class="@(RawSortingModel.SortIcons["PartNumber"]) setSVG"
                                                                @onclick="@(async () => await SortRaw("PartNumber"))" />
                                                        </div>
                                                    </th>
                                                    <th>
                                                        <div class="segmentRow">
                                                            <div style="margin-left: 8px;">Description</div>
                                                            <div class="@(RawSortingModel.SortIcons["Description"]) setSVG"
                                                                @onclick="@(async () => await SortRaw("Description"))" />
                                                        </div>
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (RawPaginationService.GetItems().Any())
                                                {
                                                    @foreach (var item in RawPaginationService.GetItems())
                                                    {
                                                        <tr class="@(selectedRaw?.ID == item.ID ? "row-active" : "")"
                                                            @onclick="() => SelectRaw(item)">
                                                            <td>
                                                                <div>@item.PartNumber</div>
                                                            </td>
                                                            <td>
                                                                <div>@item.Description</div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="2" class="text-center no-select">
                                                            <div>No data</div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="Paging">
                                        <Pagination T="MattelClass.SheetData" PaginationService="RawPaginationService"
                                            OnPageChanged="OnPageChanged" />
                                    </div>
                                </div>
                                <div class="segmentColumn2">
                                    <div class="table-set gapLeft">
                                        <table class="table scrolldown">
                                            <colgroup>
                                                <col style="width: 260px;">
                                            </colgroup>
                                            <thead>
                                                <tr>
                                                    <th>
                                                        <div class="segmentRow">
                                                            <div style="margin-left: 8px;">Part # to be Saved</div>
                                                            <div class="@(PartSortingModel.SortIcons["PartNumber"]) setSVG"
                                                                @onclick="@(async () => await SortPart("PartNumber"))" />
                                                        </div>
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (PartPaginationService.GetItems().Any())
                                                {
                                                    @foreach (var part in PartPaginationService.GetItems())
                                                    {
                                                        <tr class="@(selectedPart?.PartNumber == part.PartNumber ? "row-active" : "")"
                                                            @onclick="() => SelectPartNumber(part)">
                                                            <td>
                                                                <div>@part.PartNumber</div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="1" class="text-center no-select">
                                                            <div>No data</div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="Paging">
                                        <Pagination T="MattelClass.SheetData" PaginationService="PartPaginationService"
                                            OnPageChanged="OnPageChanged2" />
                                    </div>
                                </div>
                                <div class="gapLeft segmentColumn">
                                    <button type="button"
                                        @onclick="() => { if (!string.IsNullOrWhiteSpace(selectedKitNumber) && selectedRaw != null) AddPart(); }"
                                        class="btn button-add-part" style="@AddPartBtnStyle">
                                        Add Part
                                    </button>
                                    <button type="button" @onclick="() => { if (selectedPart != null) EditPart(); }"
                                        class="btn button-edit-part" style="@EditPartBtnStyle">
                                        Edit Part
                                    </button>
                                    <button type="button" @onclick="() => { if (selectedPart != null) RmvPart(); }"
                                        class="btn button-rmv-part" style="@RmvPartBtnStyle">
                                        Del Part
                                    </button>
                                    <button type="button"
                                        @onclick="() => { if (!string.IsNullOrWhiteSpace(selectedKitNumber) && (partData?.Any() == true)) Reset(); }"
                                        class="btn button-reset gapTop" style="@ResetBtnStyle">
                                        Reset
                                    </button>
                                    <button type="button" @onclick="Cancel" class="btn button-cancel">
                                        Cancel
                                    </button>
                                    <button type="button"
                                        @onclick="() => { if (!string.IsNullOrWhiteSpace(selectedKitNumber) && (partData?.Any() == true)) Save(); }"
                                        class="btn button-save" style="@SaveBtnStyle">
                                        Save
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                @if (showModal)
                {
                    <div class="modal-overlay" style="@(showModal ? "display: flex;" : "display: none;")">
                        <div class="modal-content">
                            <div class="modal-header">
                                @if (modalContent == "EditKit")
                                {
                                    <div>Edit Kit Number</div>
                                }
                                else if (modalContent == "editPart")
                                {
                                    <div>Edit Part Number</div>
                                }
                            </div>
                            @if (modalContent == "EditKit" && dataKit != null)
                            {
                                <EditKit ShowModalChanged="ShowEditKitModalChanged" OnKitEdited="OnKitEdited"
                                    EditKitData="@dataKit" />
                            }
                            else if (modalContent == "editPart" && dataPart != null)
                            {
                                <EditPart ShowModalChanged="ShowEditPartModalChanged" OnPartEdited="OnPartEdited"
                                    EditPartData="@dataPart" />
                            }
                        </div>
                    </div>
                }
                <PopMsg PopMsgData="@popMsgData" />
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <span class="spinner-border spinner-border-lg align-center"></span>
        <span> Checking authorization in progress ...........</span>
    </NotAuthorized>
</AuthorizeView>