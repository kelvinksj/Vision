@page "/Mattel/Scan/AddPart"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject WorkerService WorkerService
@inject ScreenWakeLockService ScreenWakeLockService
@inject CommonLib CommonLib
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime jsRuntime
@inject MattelService MattelService

<style>
    .input-style {
        width: 250px;
        background-color: rgba(217, 217, 217, 1);
        border-bottom: none;
    }

    .modal-content {
        width: 400px;
    }
</style>

<PageTitle>@CommonParameters.AppName</PageTitle>

<div class="box2">
    <div class="segmentColumn">
        <div class="segmentColumn gapBottom">
            <label class="no-select">New Value</label>
            <input @bind="list.PartNumber" class="form-control input-style" maxlength="15" autocomplete="off" />
        </div>
        <div class="segmentRow gapBottom">
            <button type="button" @onclick="Confirm" class="btn button-confirm">Confirm</button>
            <button type="button" @onclick="CloseModal" class="btn button-cancel">Cancel</button>
        </div>
    </div>
</div>